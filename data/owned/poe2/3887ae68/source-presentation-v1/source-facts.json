        "function CalcSectionClass:GetOverlayHeight()",
        "\tlocal height = 28",
        "\tlocal enabled = self.calcsTab.calcsEnv and self.calcsTab:CheckFlag(self)",
        "\tfor i, subSec in ipairs(self.subSection) do",
        "\t\theight = height + 22",
        "\t\tif not subSec.collapsed and enabled then",
        "\t\t\tfor _, rowData in ipairs(subSec.data) do",
        "\t\t\t\tif self.calcsTab:CheckFlag(rowData) then",
        "\t\t\t\t\theight = height + 18",
        "\t\t\t\tend",
        "\t\t\tend",
        "\t\t\theight = height + 2",
        "\t\telseif i == 1 then",
        "\t\t\tbreak",
        "\t\tend"
      ]
    },
