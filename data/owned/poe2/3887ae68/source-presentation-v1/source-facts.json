        "-- Zoom the tree in or out",
        "function PassiveTreeViewClass:Zoom(level, viewPort)",
        "\t-- Calculate new zoom level and zoom factor",
        "\tself.zoomLevel = m_max(0, m_min(20, self.zoomLevel + level))",
        "\tlocal oldZoom = self.zoom",
        "\tself.zoom = 1.2 ^ self.zoomLevel",
        "",
        "\t-- Adjust zoom center position so that the point on the tree that is currently under the mouse will remain under it",
        "\tlocal factor = self.zoom / oldZoom",
        "\tlocal cursorX, cursorY = GetCursorPos()",
        "\tlocal relX = cursorX - viewPort.x - viewPort.width/2",
        "\tlocal relY = cursorY - viewPort.y - viewPort.height/2",
        "\tself.zoomX = relX + (self.zoomX - relX) * factor",
        "\tself.zoomY = relY + (self.zoomY - relY) * factor",
        "end",
        "",
        "---@param build Build",
        "function PassiveTreeViewClass:Focus(x, y, viewPort, build)",
        "\tself.zoomLevel = 20",
        "\tself.zoom = 1.2 ^ self.zoomLevel"
      ]
