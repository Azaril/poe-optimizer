        "function CalcsTabClass:Load(xml, dbFileName)",
        "\tfor _, node in ipairs(xml) do",
        "\t\tif type(node) == \"table\" then",
        "\t\t\tif node.elem == \"Input\" then",
        "\t\t\t\tif not node.attrib.name then",
        "\t\t\t\t\tlaunch:ShowErrMsg(\"^1Error parsing '%s': 'Input' element missing name attribute\", fileName)",
        "\t\t\t\t\treturn true",
        "\t\t\t\tend",
        "\t\t\t\tif node.attrib.number then",
        "\t\t\t\t\tself.input[node.attrib.name] = tonumber(node.attrib.number)",
        "\t\t\t\telseif node.attrib.string then",
        "\t\t\t\t\tself.input[node.attrib.name] = node.attrib.string",
        "\t\t\t\telseif node.attrib.boolean then",
        "\t\t\t\t\tself.input[node.attrib.name] = node.attrib.boolean == \"true\"",
        "\t\t\t\telse",
        "\t\t\t\t\tlaunch:ShowErrMsg(\"^1Error parsing '%s': 'Input' element missing number, string or boolean attribute\", fileName)",
        "\t\t\t\t\treturn true",
        "\t\t\t\tend",
        "\t\t\telseif node.elem == \"Section\" then",
        "\t\t\t\tif not node.attrib.id then",
        "\t\t\t\t\tlaunch:ShowErrMsg(\"^1Error parsing '%s': 'Section' element missing id attribute\", fileName)",
        "\t\t\t\t\treturn true",
        "\t\t\t\tend",
        "\t\t\t\tfor _, section in ipairs(self.sectionList) do",
        "\t\t\t\t\tif section.id == node.attrib.id and node.attrib.subsection then",
        "\t\t\t\t\t\tfor _, subsection in ipairs(section.subSection) do",
        "\t\t\t\t\t\t\tif subsection.id == node.attrib.subsection then",
        "\t\t\t\t\t\t\t\tsubsection.collapsed = node.attrib.collapsed == \"true\"",
        "\t\t\t\t\t\t\t\tbreak",
        "\t\t\t\t\t\t\tend",
        "\t\t\t\t\t\tend",
        "\t\t\t\t\t\tbreak",
        "\t\t\t\t\tend",
        "\t\t\t\tend",
        "\t\t\tend",
        "\t\tend",
        "\tend",
        "\tself:ResetUndo()",
        "end"
      ]
    },
