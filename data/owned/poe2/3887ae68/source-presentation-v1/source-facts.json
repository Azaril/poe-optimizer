        "function PassiveTreeViewClass:Load(xml, fileName)",
        "\tif xml.attrib.zoomLevel then",
        "\t\tself.zoomLevel = tonumber(xml.attrib.zoomLevel)",
        "\t\tself.zoom = 1.2 ^ self.zoomLevel",
        "\tend",
        "\tif xml.attrib.zoomX and xml.attrib.zoomY then",
        "\t\tself.zoomX = tonumber(xml.attrib.zoomX)",
        "\t\tself.zoomY = tonumber(xml.attrib.zoomY)",
        "\tend",
        "\tif xml.attrib.searchStr then",
        "\t\tself.searchStr = xml.attrib.searchStr",
        "\t\tself.searchStrSaved = xml.attrib.searchStr",
        "\tend",
        "\tif xml.attrib.showStatDifferences then",
        "\t\tself.showStatDifferences = xml.attrib.showStatDifferences == \"true\"",
        "\tend",
        "end",
        "",
        "function PassiveTreeViewClass:Save(xml)",
        "\tself.searchStrSaved = self.searchStr",
        "\txml.attrib = {",
        "\t\tzoomLevel = tostring(self.zoomLevel),",
        "\t\tzoomX = tostring(self.zoomX),",
        "\t\tzoomY = tostring(self.zoomY),",
        "\t\tsearchStr = self.searchStr,",
        "\t\tshowStatDifferences = tostring(self.showStatDifferences),",
        "\t}"
      ]
    },
