        "\t\tif activeSkill.socketGroup and activeSkill.socketGroup.includeInFullDPS then",
        "\t\t\tlocal uuid = cacheStore and cacheSkillUUID(activeSkill, fullEnv)",
        "\t\t\tlocal canCacheSkill = not (activeSkill.triggeredBy or activeSkill.skillData.triggered)",
        "\t\t\tlocal cachedPasses",
        "\t\t\tif canCacheSkill and surfaceSame and activeSkill.baseSkillModList then",
        "\t\t\t\tlocal ref = cacheStore.refs[uuid]",
        "\t\t\t\tif ref and cacheStore.snapshots[uuid] and modListsEqual(ref, activeSkill.baseSkillModList) then",
        "\t\t\t\t\tcachedPasses = cacheStore.snapshots[uuid]",
        "\t\t\t\tend",
        "\t\t\tend",
        "\t\t\tlocal activeSkillCount, enabled",
        "\t\t\tif not cachedPasses then",
        "\t\t\t\tactiveSkillCount, enabled = calcs.getActiveSkillCount(activeSkill)",
        "\t\t\tend",
        "\t\t\tif cachedPasses then",
        "\t\t\t\t-- This skill's own mod list and the coupling surface are unchanged since the",
        "\t\t\t\t-- capture pass, so its results cannot have changed: merge the cached passes",
        "\t\t\t\tfor _, pass in ipairs(cachedPasses) do",
        "\t\t\t\t\tmergeFullDPSPass(fullDPS, sources, pass)",
        "\t\t\t\tend",
        "\t\t\telseif enabled then",
        "\t\t\t\tlocal ownRef",
        "\t\t\t\tif canCacheSkill and cacheStore and fullDPSCache.capture and activeSkill.baseSkillModList then",
        "\t\t\t\t\t-- Reference the skill's pre-perform mod list for later input diffing",
        "\t\t\t\t\townRef = { }",
        "\t\t\t\t\tfor i, mod in ipairs(activeSkill.baseSkillModList) do",
        "\t\t\t\t\t\townRef[i] = mod",
        "\t\t\t\t\tend",
        "\t\t\t\tend",
        "\t\t\t\tfullEnv.player.mainSkill = activeSkill",
        "\t\t\t\tcalcs.perform(fullEnv, true)",
        "\t\t\t\tusedEnv = fullEnv",
        "\t\t\t\t-- Capture this pass's results into a plain snapshot, then merge it into the totals;",
        "\t\t\t\t-- the snapshot lets later calls reuse the results when this skill's inputs are unchanged",
        "\t\t\t\tlocal skillName = calcs.getActiveSkillDisplayName(activeSkill)",
        "\t\t\t\tlocal dotCanStack = activeSkill.activeEffect.statSet.skillFlags.DotCanStack",
        "\t\t\t\tlocal pass = { actors = { } }",
        "\t\t\t\tlocal minionOut",
        "\t\t\t\tif activeSkill.minion or usedEnv.minion then",
        "\t\t\t\t\tminionOut = captureFields(usedEnv.minion.output)",
        "\t\t\t\t\tlocal minionNamePrefix = (activeSkill.minion and activeSkill.minion.minionData.name..\": \") or (usedEnv.minion and usedEnv.minion.minionData.name..\": \") or \"\"",
        "\t\t\t\t\tt_insert(pass.actors, {",
        "\t\t\t\t\t\tout = minionOut,",
        "\t\t\t\t\t\tname = skillName,",
        "\t\t\t\t\t\tcount = activeSkillCount,",
        "\t\t\t\t\t\ttrigger = activeSkill.infoTrigger,",
        "\t\t\t\t\t\tskillPart = minionNamePrefix .. activeSkill.skillPartName,",
        "\t\t\t\t\t\tsourceName = skillName,",
        "\t\t\t\t\t\tdotScale = 1,",
        "\t\t\t\t\t})",
        "\t\t\t\t\t-- This is a fix to prevent Absolution spell hit from being counted multiple times when increasing minions count"
      ]
