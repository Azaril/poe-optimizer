        "function calcs.getActiveSkillCount(activeSkill)",
        "\tif not activeSkill.socketGroup then",
        "\t\treturn 1, true",
        "\telseif activeSkill.socketGroup.groupCount then",
        "\t\treturn activeSkill.socketGroup.groupCount, true",
        "\telse",
        "\t\tlocal gemList = activeSkill.socketGroup.gemList",
        "\t\tfor _, gemData in pairs(gemList) do",
        "\t\t\tif gemData.gemData then",
        "\t\t\t\tif gemData.gemData.vaalGem then",
        "\t\t\t\t\tif activeSkill.activeEffect.grantedEffect == gemData.gemData.grantedEffectList[1] then",
        "\t\t\t\t\t\treturn gemData.count or 1,  gemData.enableGlobal1 == true",
        "\t\t\t\t\telseif activeSkill.activeEffect.grantedEffect == gemData.gemData.grantedEffectList[2] then",
        "\t\t\t\t\t\treturn gemData.count or 1,  gemData.enableGlobal2 == true",
        "\t\t\t\t\tend",
        "\t\t\t\telse",
        "\t\t\t\t\tif (activeSkill.activeEffect.grantedEffect == gemData.gemData.grantedEffect and not gemData.gemData.grantedEffect.support) or isValueInArray(gemData.gemData.additionalGrantedEffects, activeSkill.activeEffect.grantedEffect) then",
        "\t\t\t\t\t\treturn gemData.count or 1, true",
        "\t\t\t\t\tend",
        "\t\t\t\tend",
        "\t\t\tend",
        "\t\tend",
        "\tend",
        "\treturn 1, true",
        "end"
      ]
    },
