      "lines": [
        "\tself.rawLines = { }",
        "\t-- Find non-blank lines and trim whitespace",
        "\tfor line in raw:gmatch(\"%s*([^\\n]*%S)\") do",
        "\t\tline = escapeGGGString(line)",
        "\t\tt_insert(self.rawLines, line)",
        "\tend",
        "\tlocal mode = rarity and \"GAME\" or \"WIKI\"",
        "\tlocal l = 1",
        "\tlocal itemClass",
        "\tif self.rawLines[l] then",
        "\t\tif self.rawLines[l]:match(\"^Item Class:\") then",
        "\t\t\titemClass = self.rawLines[l]:gsub(\"^Item Class: %s+\", \"%1\")",
        "\t\t\tl = l + 1 -- Item class is already determined by the base type",
        "\t\tend",
        "\t\tlocal rarity = self.rawLines[l]:match(\"^Rarity: (%a+)\")",
        "\t\tif rarity then",
        "\t\t\tmode = \"GAME\"",
        "\t\t\tif colorCodes[rarity:upper()] then",
        "\t\t\t\tself.rarity = rarity:upper()",
        "\t\t\tend",
        "\t\t\tif self.rarity == \"UNIQUE\" then",
        "\t\t\t\t-- Hack for relics",
        "\t\t\t\tfor _, line in ipairs(self.rawLines) do",
        "\t\t\t\t\tif line:find(\"Foil Unique\") then",
        "\t\t\t\t\t\tself.rarity = \"RELIC\"",
        "\t\t\t\t\t\tbreak",
        "\t\t\t\t\tend",
        "\t\t\t\tend",
        "\t\t\tend",
        "\t\t\tl = l + 1",
        "\t\tend",
        "\tend",
        "\tif self.rawLines[l] then",
        "\t\tif self.rawLines[l] == \"--------\" then",
        "\t\t\tl = l + 1",
        "\t\tend",
        "\t\t-- Determine if \"Unidentified\" item",
        "\t\tlocal unidentified = false",
        "\t\tif self.rarity == \"UNIQUE\" then",
        "\t\t\tlocal unidentifiedBase = data.itemBases[self.rawLines[l]]",
        "\t\t\tlocal identifiedBase = data.itemBases[self.rawLines[l+1]]",
        "\t\t\tif unidentifiedBase and not identifiedBase then",
        "\t\t\t\tunidentified = true",
        "\t\t\t\tself.name = \"Unidentified item\"",
        "\t\t\t\tself.baseName = self.rawLines[l]",
        "\t\t\t\tself.base = unidentifiedBase",
        "\t\t\telse",
        "\t\t\t\tself.name = self.rawLines[l]",
        "\t\t\tend",
        "\t\telse",
        "\t\t\tself.name = self.rawLines[l]",
        "\t\tend",
        "\t\tfor _, line in ipairs(self.rawLines) do",
        "\t\t\tif line == \"Unidentified\" then",
        "\t\t\t\tunidentified = true",
        "\t\t\t\tbreak",
        "\t\t\tend",
        "\t\tend",
        "",
        "\t\t-- Found the name for a rare or unique, but let's parse it if it's a magic or normal or Unidentified item to get the base",
        "\t\tif not (self.rarity == \"NORMAL\" or self.rarity == \"MAGIC\" or unidentified) then",
        "\t\t\tl = l + 1",
        "\t\tend",
        "\tend",
        "\tself.checkSection = false",
        "\tself.sockets = { }",
        "\tself.runes = { }"
      ]
    },
