        "function calcLib.validateGemLevel(gemInstance)",
        "\tlocal grantedEffect = gemInstance.grantedEffect or gemInstance.gemData.grantedEffect",
        "\tif not grantedEffect.levels[gemInstance.level] then",
        "\t\t-- Try limiting to the level range of the skill",
        "\t\tgemInstance.level = m_max(1, gemInstance.level)",
        "\t\tif #grantedEffect.levels > 0 then",
        "\t\t\tgemInstance.level = m_min(#grantedEffect.levels, gemInstance.level)",
        "\t\tend",
        "\tend",
        "\tif not grantedEffect.levels[gemInstance.level] and gemInstance.gemData and gemInstance.gemData.naturalMaxLevel then",
        "\t\tgemInstance.level = gemInstance.gemData.naturalMaxLevel",
        "\tend",
        "\tif not grantedEffect.levels[gemInstance.level] then",
        "\t\t-- That failed, so just grab any level",
        "\t\tgemInstance.level = next(grantedEffect.levels)",
        "\tend",
        "end",
        "",
        "local typeExpressionStack = { }"
      ]
    },
