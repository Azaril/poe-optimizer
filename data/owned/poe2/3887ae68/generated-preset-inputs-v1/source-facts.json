        "local function getNormalizedSkillLevel(grantedSkill)",
        "\t-- Levels in socketGroup.gemList[1].level are normalized",
        "\t-- grantedSkill.level is not causing group match miss which causes all things that rely on group order to fail",
        "\tlocal normalizedGrantedSkill = {",
        "\t\tgrantedEffect = data.skills[grantedSkill.skillId],",
        "\t\tlevel = grantedSkill.level",
        "\t}",
        "\tcalcLib.validateGemLevel(normalizedGrantedSkill)",
        "\treturn normalizedGrantedSkill.level",
        "end",
        ""
      ]
    },
