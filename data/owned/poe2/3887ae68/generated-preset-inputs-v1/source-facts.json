        "\tif not accelerate.nodeAlloc then",
        "\t\tfor _, node in pairs(env.allocNodes) do",
        "\t\t\tif node.grantedSkills then",
        "\t\t\t\tfor _, skill in ipairs(node.grantedSkills) do",
        "\t\t\t\t\tlocal grantedSkill = copyTable(skill)",
        "\t\t\t\t\tgrantedSkill.sourceNode = node",
        "\t\t\t\t\tt_insert(env.grantedSkillsNodes, grantedSkill)",
        "\t\t\t\tend",
        "\t\t\tend",
        "\t\tend",
        "\tend",
        "",
        "\t-- Merge Granted Skills Tables",
        "\tenv.grantedSkills = tableConcat(env.grantedSkillsNodes, env.grantedSkillsItems)",
        "",
        "\tlocal virtuousMoteSkillCount = accelerate.skills and env.virtuousMoteSkillCount or { Str = 3, Dex = 3, Int = 3 }",
        "\tlocal virtuousMoteSkillCounted = { }"
      ]
