program "resolve-player-incoming-critical-chance" context actor {
    read "actor-chance-increase" as r_0: quantity(unit.percentage_points) = stat(current, stat.player_incoming_critical_chance_increase);
    read "always" as r_1: boolean = contribution_query(enemy, "player-critical-always", "all");
    read "category" as r_2: option = external(enemy, external_input.incoming_damage_inputs.category_input);
    read "configured-chance" as r_3: quantity(unit.percentage_points) = external(enemy, external_input.enemy_critical_strike_chance);
    read "configured-evade" as r_4: quantity(unit.percentage_points) = stat(current, stat.player_configured_critical_evade);
    read "enemy-chance-increase" as r_5: quantity(unit.percentage_points) = stat(enemy, stat.enemy_critical_chance_increase);
    read "never" as r_6: boolean = contribution_query(enemy, "player-critical-never", "all");
    read "override-present" as r_7: boolean = contribution_selection(current, "player-critical-override", "all", present);
    read "override-value" as r_8: quantity(unit.percentage_points) = contribution_selection(current, "player-critical-override", "all", value);
    read "unlucky" as r_9: boolean = contribution_query(current, "player-critical-unlucky", "all");
    let n_0 = r_0;
    let n_1 = pct(n_0, unit.factor);
    let n_2 = r_1;
    let n_3 = r_2;
    let n_4 = r_3;
    let n_5 = r_4;
    let n_6 = pct(n_5, unit.factor);
    let n_7 = option(option.player_critical_receivers.damage_over_time);
    let n_8 = r_5;
    let n_9 = pct(n_8, unit.factor);
    let n_10 = quantity(100, unit.percentage_points);
    let n_11 = n_3 == n_7;
    let n_12 = not n_11;
    let n_13 = r_6;
    let n_14 = quantity(1, unit.factor);
    let n_15 = n_14 + n_1;
    let n_16 = n_15 + n_9;
    let n_17 = n_14 - n_6;
    let n_18 = r_7;
    let n_19 = r_8;
    let n_20 = if n_18 { n_19 } else { n_4 };
    let n_21 = scale(n_20, n_16);
    let n_22 = scale(n_21, n_17);
    let n_23 = r_9;
    let n_24 = min(n_22, n_10);
    let n_25 = quantity(0, unit.percentage_points);
    let n_26 = max(n_24, n_25);
    let n_27 = if n_2 { n_10 } else { n_26 };
    let n_28 = if n_13 { n_25 } else { n_27 };
    let n_29 = pct(n_28, unit.factor);
    let n_30 = scale(n_28, n_29);
    let n_31 = if n_23 { n_30 } else { n_28 };
    effect "chance" when n_12 = derive(current, stat.player_incoming_critical_chance, n_31);
}
