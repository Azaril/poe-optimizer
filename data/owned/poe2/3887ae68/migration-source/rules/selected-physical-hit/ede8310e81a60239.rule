program "selected-physical-hit" context action {
    read "base-max" as r_0: quantity(unit.damage) = stat(current, stat.selected_physical_base_maximum);
    read "base-min" as r_1: quantity(unit.damage) = stat(current, stat.selected_physical_base_minimum);
    read "debilitated" as r_2: boolean = contribution_query(actor, "selected-actor-debilitated", "sources");
    read "increase" as r_3: quantity(unit.percentage_points) = stat(current, stat.selected_physical_hit.increased_subtotal);
    read "intimidated" as r_4: boolean = contribution_query(actor, "selected-actor-intimidated", "sources");
    read "more-contributions" as r_5: quantity(unit.factor) = contribution_query(actor, "owned-minion-unconditional-more-contributions", "sources");
    read "quality" as r_6: quantity(unit.factor) = stat(actor, stat.sniper_quality_damage_factor);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = quantity(0.9, unit.factor);
    let n_4 = quantity(0.5, unit.factor);
    let n_5 = r_3;
    let n_6 = r_4;
    let n_7 = quantity(-10, unit.percentage_points);
    let n_8 = r_5;
    let n_9 = quantity(1, unit.factor);
    let n_10 = if n_2 { n_3 } else { n_9 };
    let n_11 = quantity(100, unit.factor);
    let n_12 = r_6;
    let n_13 = scale(n_10, n_12);
    let n_14 = scale(n_13, n_8);
    let n_15 = scale(n_14, n_11);
    let n_16 = n_15 + n_4;
    let n_17 = round(n_16, quantity(1, unit.factor), floor);
    let n_18 = divide_factor(n_17, n_11);
    let n_19 = quantity(0, unit.percentage_points);
    let n_20 = if n_6 { n_7 } else { n_19 };
    let n_21 = n_20 + n_5;
    let n_22 = pct(n_21, unit.factor);
    let n_23 = n_9 + n_22;
    let n_24 = scale(n_0, n_23);
    let n_25 = scale(n_1, n_23);
    let n_26 = scale(n_24, n_18);
    let n_27 = round(n_26, quantity(1, unit.damage), nearest_ties_positive);
    let n_28 = scale(n_25, n_18);
    let n_29 = round(n_28, quantity(1, unit.damage), nearest_ties_positive);
    effect "minimum" = derive(current, stat.selected_physical_hit_minimum, n_29);
    effect "maximum" = derive(current, stat.selected_physical_hit_maximum, n_27);
}
