program "raw-base-defence-profile" context equipment_use {
    let n_0 = true;
    let n_1 = false;
    let n_2 = quantity(0, unit.defence_rating);
    let n_3 = quantity(20, unit.percentage_points);
    let n_4 = quantity(0, unit.energy_shield_points);
    let n_5 = quantity(67, unit.defence_rating);
    let n_6 = quantity(23, unit.ward_points);
    effect "raw-0" = derive(current, stat.defence_profiles.fields.armour.stat, n_2);
    effect "raw-1" = derive(current, stat.defence_profiles.fields.blockchance.stat, n_3);
    effect "field-present-1" = capability(current, capability.defence_profiles.fields.blockchance.presence, n_0);
    effect "raw-2" = derive(current, stat.defence_profiles.fields.energyshield.stat, n_4);
    effect "raw-3" = derive(current, stat.defence_profiles.fields.evasion.stat, n_5);
    effect "field-present-4" = capability(current, capability.defence_profiles.fields.movementpenalty.presence, n_1);
    effect "raw-5" = derive(current, stat.defence_profiles.fields.ward.stat, n_6);
}
