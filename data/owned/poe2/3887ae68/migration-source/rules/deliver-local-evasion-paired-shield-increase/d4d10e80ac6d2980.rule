program "deliver-local-evasion-paired-shield-increase" context equipment_use {
    read "amount" as r_0: quantity(unit.percentage_points) = stat(modifier, stat.modifier_effective_percent);
    let n_0 = r_0;
    effect "local" = contribute(current, stat.local_defence_composition.channels.evasion_energy_shield, increase, n_0);
}
