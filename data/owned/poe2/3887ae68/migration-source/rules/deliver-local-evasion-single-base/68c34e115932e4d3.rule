program "deliver-local-evasion-single-base" context equipment_use {
    read "amount" as r_0: quantity(unit.count) = stat(modifier, stat.modifier_effective_count);
    let n_0 = r_0;
    let n_1 = quantity(1, unit.count);
    let n_2 = ratio(n_0, n_1, unit.factor);
    let n_3 = quantity(1, unit.defence_rating);
    let n_4 = scale(n_3, n_2);
    effect "local" = contribute(current, stat.item_local_evasion, add, n_4);
}
