program "owned-minion-action-increase" context action {
    read "applied" as r_0: quantity(unit.percentage_points) = contribution_query(current, "owned-minion-command-action-increase", "sources");
    read "inherited" as r_1: quantity(unit.percentage_points) = stat(actor, stat.minion_unconditional_damage_increase);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = n_1 + n_0;
    effect "increase" = derive(current, stat.selected_physical_hit.increased_subtotal, n_2);
}
