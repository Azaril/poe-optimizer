program "recipient-empty-buff-effect-increase" context actor {
    read "incoming" as r_0: quantity(unit.percentage_points) = contribution_query(current, "recipient-empty-buff-effect-increase-domain", "empty");
    let n_0 = r_0;
    effect "resolved" = derive(current, stat.pain_offering.recipient_effect_increased, n_0);
}
