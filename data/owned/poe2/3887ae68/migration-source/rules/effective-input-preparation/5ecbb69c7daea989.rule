program "effective-input-preparation" context support_origin {
    read "external-level-0" as r_0: quantity(unit.count) = contributions(player, stat.global_minion_gem_level_addition, add, sum, quantity(0, unit.count));
    read "raw-level" as r_1: integer = gem_level();
    read "raw-quality" as r_2: quantity(unit.percentage_points) = gem_quality_amount(quality.standard_quality);
    let n_0 = r_0;
    let n_1 = quantity(1, unit.count);
    let n_2 = quantity(1, unit.count);
    let n_3 = 1;
    let n_4 = r_1;
    let n_5 = scale_integer(n_2, n_4);
    let n_6 = n_5 + n_0;
    let n_7 = max(n_6, n_2);
    let n_8 = min(n_7, n_1);
    let n_9 = quantize_integer(n_8, quantity(1, unit.count), truncate);
    let n_10 = scale_integer(n_2, n_9);
    let n_11 = n_8 == n_10;
    let n_12 = if n_11 { n_9 } else { n_3 };
    let n_13 = r_2;
    effect "level" = derive(current, stat.prepared_support_level, n_12);
    effect "quality" = derive(current, stat.prepared_support_quality, n_13);
}
