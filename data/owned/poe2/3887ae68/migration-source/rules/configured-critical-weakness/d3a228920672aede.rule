program "configured-critical-weakness" context actor {
    read "enabled" as r_0: boolean = contribution_query(current, "outgoing-critical-weakness-enabled", "sources");
    read "raw-stacks" as r_1: quantity(unit.count) = external(current, external_input.enemy.critical_weakness_stacks);
    let n_0 = r_0;
    let n_1 = quantity(1, unit.percentage_points);
    let n_2 = r_1;
    let n_3 = quantity(20, unit.count);
    let n_4 = quantity(2, unit.count);
    let n_5 = min(n_2, n_3);
    let n_6 = quantity(0, unit.count);
    let n_7 = max(n_5, n_6);
    let n_8 = ratio(n_7, n_4, unit.factor);
    let n_9 = n_2 == n_6;
    let n_10 = not n_9;
    let n_11 = all(n_0, n_10);
    let n_12 = scale(n_1, n_8);
    effect "critical-weakness" when n_11 = contribute(current, stat.enemy_self_critical_chance, add, n_12);
}
