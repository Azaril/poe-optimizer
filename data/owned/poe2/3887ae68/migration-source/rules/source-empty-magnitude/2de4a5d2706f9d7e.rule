program "source-empty-magnitude" context skill {
    read "increased" as r_0: quantity(unit.percentage_points) = contribution_query(current, "source-empty-magnitude-increase-domain", "empty");
    read "more" as r_1: quantity(unit.factor) = contribution_query(current, "source-empty-magnitude-more-domain", "empty");
    let n_0 = r_0;
    let n_1 = pct(n_0, unit.factor);
    let n_2 = r_1;
    let n_3 = quantity(1, unit.factor);
    let n_4 = n_3 + n_1;
    let n_5 = scale(n_4, n_2);
    effect "resolved" = derive(current, stat.pain_offering.source_magnitude, n_5);
}
