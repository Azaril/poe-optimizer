program "minion-command-delivery" context action {
    read "commandable" as r_0: boolean = stat(current, stat.command_damage.channels.commandable);
    let n_0 = r_0;
    let n_1 = quantity(80, unit.percentage_points);
    effect "cooldown" when n_0 = contribute(current, stat.command_cooldown.channels.action, increase, n_1);
}
