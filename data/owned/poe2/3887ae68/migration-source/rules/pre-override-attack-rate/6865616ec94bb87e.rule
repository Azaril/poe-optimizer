program "pre-override-attack-rate" context equipment_use {
    read "increase" as r_0: quantity(unit.percentage_points) = contributions(current, stat.local_weapon_inputs.stats.pre_override_attack_rate, increase, sum, quantity(0, unit.percentage_points));
    read "quality" as r_1: quantity(unit.percentage_points) = stat(current, stat.item_quality_inputs.quality_stat);
    read "quality-effect" as r_2: quantity(unit.percentage_points) = contributions(current, stat.local_weapon_inputs.stats.quality_speed_percent, add, sum, quantity(0, unit.percentage_points));
    read "raw" as r_3: quantity(unit.action_rate) = stat(current, stat.weapon_profiles.fields.attackratebase.stat);
    let n_0 = r_0;
    let n_1 = quantity(1, unit.factor);
    let n_2 = r_1;
    let n_3 = quantity(8, unit.percentage_points);
    let n_4 = r_2;
    let n_5 = ratio(n_2, n_3, unit.factor);
    let n_6 = scale(n_4, n_5);
    let n_7 = round(n_6, quantity(1, unit.percentage_points), floor);
    let n_8 = r_3;
    let n_9 = quantity(0.5, unit.action_rate);
    let n_10 = quantity(100, unit.factor);
    let n_11 = n_0 + n_7;
    let n_12 = pct(n_11, unit.factor);
    let n_13 = n_1 + n_12;
    let n_14 = scale(n_8, n_13);
    let n_15 = scale(n_14, n_10);
    let n_16 = n_15 + n_9;
    let n_17 = round(n_16, quantity(1, unit.action_rate), floor);
    let n_18 = divide_factor(n_17, n_10);
    effect "derive" = derive(current, stat.local_weapon_inputs.stats.pre_override_attack_rate, n_18);
}
