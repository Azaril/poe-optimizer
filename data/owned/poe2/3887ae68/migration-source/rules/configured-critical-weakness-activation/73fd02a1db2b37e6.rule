program "configured-critical-weakness-activation" context actor {
    read "configured" as r_0: boolean = external(current, external_input.enemy.critical_weakness_active);
    let n_0 = r_0;
    let n_1 = true;
    effect "configured-activation" when n_0 = contribute(current, stat.enemy_apply_critical_weakness, flag, n_1);
}
