program "local-maximum-add" context equipment_use {
    read "effective" as r_0: quantity(unit.damage) = stat(modifier, stat.modifier_value_inputs.stats.effective_damage_maximum);
    let n_0 = r_0;
    effect "contribute" = contribute(current, stat.local_weapon_inputs.stats.rounded_physical_maximum, add, n_0);
}
