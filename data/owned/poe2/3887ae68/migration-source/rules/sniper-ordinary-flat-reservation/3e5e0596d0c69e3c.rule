program "sniper-ordinary-flat-reservation" context action {
    read "active-mine-count-present" as r_0: boolean = stat(current, stat.sniper_reservation.stats.active_mine_count_present);
    read "base" as r_1: quantity(unit.spirit_points) = stat(current, stat.sniper_spirit_reservation);
    read "efficiency-increased" as r_2: quantity(unit.percentage_points) = stat(current, stat.sniper_reservation.stats.efficiency_increased);
    read "efficiency-more" as r_3: quantity(unit.factor) = stat(current, stat.sniper_reservation.stats.efficiency_more);
    read "extra-spirit" as r_4: quantity(unit.spirit_points) = stat(current, stat.sniper_reservation.stats.extra_spirit);
    read "flat-base-override-present" as r_5: boolean = stat(current, stat.sniper_reservation.stats.flat_base_override_present);
    read "flat-forced-present" as r_6: boolean = stat(current, stat.sniper_reservation.stats.flat_forced_present);
    read "free-count" as r_7: quantity(unit.count) = stat(current, stat.sniper_reservation.stats.free_count);
    read "has-reservation" as r_8: boolean = stat(current, stat.sniper_reservation.stats.has_reservation);
    read "mana-cost-gain-as-reservation" as r_9: boolean = stat(current, stat.sniper_reservation.stats.mana_cost_gain_as_reservation);
    read "multiple-reservation" as r_10: boolean = stat(current, stat.sniper_reservation.stats.multiple_reservation);
    read "reservation-becomes-cost" as r_11: boolean = stat(current, stat.sniper_reservation.stats.reservation_becomes_cost);
    read "reservation-multiplier" as r_12: quantity(unit.factor) = stat(current, stat.sniper_reservation.stats.reservation_multiplier);
    read "reserved-increased" as r_13: quantity(unit.percentage_points) = stat(current, stat.sniper_reservation.stats.reserved_increased);
    read "reserved-more" as r_14: quantity(unit.factor) = stat(current, stat.sniper_reservation.stats.reserved_more);
    read "selected-count" as r_15: quantity(unit.count) = stat(skill, stat.skill_participation.count_stat);
    read "spirit-to-life-conversion-active" as r_16: boolean = stat(current, stat.sniper_reservation.stats.spirit_to_life_conversion_active);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = r_3;
    let n_4 = r_4;
    let n_5 = n_1 + n_4;
    let n_6 = r_5;
    let n_7 = r_6;
    let n_8 = quantity(0.0001, unit.factor);
    let n_9 = r_7;
    let n_10 = quantity(0.5, unit.spirit_points);
    let n_11 = r_8;
    let n_12 = quantity(100, unit.factor);
    let n_13 = quantity(100, unit.percentage_points);
    let n_14 = r_9;
    let n_15 = quantity(-100, unit.percentage_points);
    let n_16 = max(n_2, n_15);
    let n_17 = pct(n_16, unit.factor);
    let n_18 = r_10;
    let n_19 = not n_0;
    let n_20 = not n_6;
    let n_21 = not n_7;
    let n_22 = not n_14;
    let n_23 = quantity(1, unit.count);
    let n_24 = quantity(1, unit.factor);
    let n_25 = n_24 + n_17;
    let n_26 = quantity(1, unit.percentage_points);
    let n_27 = r_11;
    let n_28 = not n_27;
    let n_29 = r_12;
    let n_30 = r_13;
    let n_31 = n_30 > n_15;
    let n_32 = n_13 + n_30;
    let n_33 = ratio(n_32, n_26, unit.factor);
    let n_34 = r_14;
    let n_35 = r_15;
    let n_36 = n_35 - n_9;
    let n_37 = r_16;
    let n_38 = not n_37;
    let n_39 = all(n_11, n_18, n_28, n_22, n_20, n_21, n_19, n_38);
    let n_40 = quantity(10000, unit.factor);
    let n_41 = scale(n_29, n_40);
    let n_42 = n_41 + n_8;
    let n_43 = round(n_42, quantity(1, unit.factor), floor);
    let n_44 = divide_factor(n_43, n_40);
    let n_45 = scale(n_5, n_44);
    let n_46 = scale(n_45, n_33);
    let n_47 = divide_factor(n_46, n_12);
    let n_48 = scale(n_47, n_34);
    let n_49 = divide_factor(n_48, n_25);
    let n_50 = divide_factor(n_49, n_3);
    let n_51 = n_50 + n_10;
    let n_52 = round(n_51, quantity(1, unit.spirit_points), floor);
    let n_53 = quantity(0, unit.spirit_points);
    let n_54 = n_45 == n_53;
    let n_55 = not n_54;
    let n_56 = max(n_52, n_53);
    let n_57 = quantity(0, unit.count);
    let n_58 = max(n_36, n_57);
    let n_59 = ratio(n_58, n_23, unit.factor);
    let n_60 = quantity(0, unit.factor);
    let n_61 = n_34 > n_60;
    let n_62 = all(n_61, n_31, n_55);
    let n_63 = if n_62 { n_56 } else { n_53 };
    let n_64 = scale(n_63, n_59);
    let n_65 = quantity(0, unit.percentage_points);
    effect "ordinary-flat-branch-required" = requirement(n_39, "ordinary-flat-reservation-branch-required");
    effect "per-use-flat" when n_39 = derive(current, stat.sniper_reservation.stats.per_use_flat, n_63);
    effect "counted-flat" when n_39 = derive(current, stat.sniper_reservation.stats.counted_flat, n_64);
}
