program "area-modifier-eligibility" context action {
    read "selected-mode" as r_0: boolean = action_mode_is(action_mode.ordinary_mode);
    read "selected-part" as r_1: boolean = action_part_is(action_part.ordinary_part);
    read "selected-set-0" as r_2: boolean = action_stat_set_is(action_stat_set.commandsanddjinnknifethrowplayer.command);
    let n_0 = false;
    let n_1 = r_0;
    let n_2 = r_1;
    let n_3 = r_2;
    let n_4 = any(n_3);
    let n_5 = all(n_2, n_1, n_4);
    effect "area" when n_5 = derive(current, stat.action_area_eligibility.channel, n_0);
}
