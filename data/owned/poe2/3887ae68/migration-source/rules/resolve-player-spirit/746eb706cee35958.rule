program "resolve-player-spirit" context actor {
    read "base" as r_0: quantity(unit.spirit_points) = contribution_query(current, "spirit-base-contributions", "sources");
    read "extra" as r_1: quantity(unit.spirit_points) = contribution_query(current, "additional-pre-scaling-spirit-sources", "sources");
    read "increase" as r_2: quantity(unit.percentage_points) = contribution_query(current, "spirit-increased-contributions", "sources");
    read "more" as r_3: quantity(unit.factor) = contribution_query(current, "spirit-more-contributions", "sources");
    read "override-present" as r_4: boolean = contribution_selection(current, "spirit-override-contributions", "sources", present);
    read "override-value" as r_5: quantity(unit.spirit_points) = contribution_selection(current, "spirit-override-contributions", "sources", value);
    read "to-armour" as r_6: quantity(unit.percentage_points) = contribution_query(current, "spirit-conversion-to-armour-sources", "sources");
    read "to-energy-shield" as r_7: quantity(unit.percentage_points) = contribution_query(current, "spirit-conversion-to-energy-shield-sources", "sources");
    read "to-evasion" as r_8: quantity(unit.percentage_points) = contribution_query(current, "spirit-conversion-to-evasion-sources", "sources");
    read "total" as r_9: quantity(unit.spirit_points) = contribution_query(current, "additional-post-scaling-spirit-sources", "sources");
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = quantity(100, unit.percentage_points);
    let n_3 = r_2;
    let n_4 = pct(n_3, unit.factor);
    let n_5 = r_3;
    let n_6 = quantity(1, unit.factor);
    let n_7 = n_6 + n_4;
    let n_8 = quantity(1, unit.spirit_points);
    let n_9 = r_4;
    let n_10 = r_5;
    let n_11 = r_6;
    let n_12 = r_7;
    let n_13 = n_12 + n_11;
    let n_14 = r_8;
    let n_15 = n_13 + n_14;
    let n_16 = min(n_15, n_2);
    let n_17 = pct(n_16, unit.factor);
    let n_18 = n_6 - n_17;
    let n_19 = scale(n_0, n_18);
    let n_20 = n_19 + n_1;
    let n_21 = scale(n_20, n_7);
    let n_22 = scale(n_21, n_5);
    let n_23 = r_9;
    let n_24 = n_22 + n_23;
    let n_25 = check_domain(n_24, quantity(-, unit.spirit_points), quantity(4503599627370496, unit.spirit_points));
    let n_26 = round(n_25, quantity(1, unit.spirit_points), nearest_ties_positive);
    let n_27 = max(n_26, n_8);
    let n_28 = if n_9 { n_10 } else { n_27 };
    effect "spirit" = derive(current, stat.player_spirit_pool.final, n_28);
}
