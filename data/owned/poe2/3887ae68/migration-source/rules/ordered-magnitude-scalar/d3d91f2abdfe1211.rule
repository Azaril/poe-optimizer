program "ordered-magnitude-scalar" context equipment_use {
    read "scalar" as r_0: quantity(unit.factor) = modifier_transforms(stat.modifier_value_inputs.ordered_magnitude, stat.modifier_catalyst_scalar);
    let n_0 = r_0;
    effect "magnitude-scalar" = derive(modifier, stat.modifier_value_inputs.ordered_magnitude, n_0);
}
