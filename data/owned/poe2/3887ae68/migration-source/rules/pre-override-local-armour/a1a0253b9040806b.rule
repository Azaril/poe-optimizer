program "pre-override-local-armour" context equipment_use {
    read "all-increase" as r_0: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.defences_increase, increase, sum, quantity(0, unit.percentage_points));
    read "alternate-quality" as r_1: quantity(unit.factor) = contributions(current, stat.local_defence_composition.channels.alternate_quality, add, sum, quantity(0, unit.factor));
    read "armour_energy_shield-base" as r_2: quantity(unit.count) = contributions(current, stat.local_defence_composition.channels.armour_energy_shield, add, sum, quantity(0, unit.count));
    read "armour_energy_shield-increase" as r_3: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.armour_energy_shield, increase, sum, quantity(0, unit.percentage_points));
    read "armour_evasion-base" as r_4: quantity(unit.defence_rating) = contributions(current, stat.local_defence_composition.channels.armour_evasion, add, sum, quantity(0, unit.defence_rating));
    read "armour_evasion-increase" as r_5: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.armour_evasion, increase, sum, quantity(0, unit.percentage_points));
    read "crafted-quality" as r_6: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.crafted_quality, add, sum, quantity(0, unit.percentage_points));
    read "quality" as r_7: quantity(unit.percentage_points) = stat(current, stat.item_quality_inputs.quality_stat);
    read "raw" as r_8: quantity(unit.defence_rating) = stat(current, stat.defence_profiles.fields.armour.stat);
    read "single-base" as r_9: quantity(unit.defence_rating) = contributions(current, stat.local_defence_composition.channels.pre_override_armour, add, sum, quantity(0, unit.defence_rating));
    read "single-increase" as r_10: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.pre_override_armour, increase, sum, quantity(0, unit.percentage_points));
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = r_3;
    let n_4 = r_4;
    let n_5 = r_5;
    let n_6 = r_6;
    let n_7 = quantity(0.5, unit.defence_rating);
    let n_8 = quantity(1, unit.count);
    let n_9 = ratio(n_2, n_8, unit.factor);
    let n_10 = quantity(1, unit.factor);
    let n_11 = quantity(1, unit.defence_rating);
    let n_12 = scale(n_11, n_9);
    let n_13 = r_7;
    let n_14 = r_8;
    let n_15 = r_9;
    let n_16 = n_15 + n_14;
    let n_17 = n_16 + n_4;
    let n_18 = n_17 + n_12;
    let n_19 = r_10;
    let n_20 = n_19 + n_5;
    let n_21 = n_20 + n_3;
    let n_22 = n_21 + n_0;
    let n_23 = pct(n_22, unit.factor);
    let n_24 = n_10 + n_23;
    let n_25 = scale(n_18, n_24);
    let n_26 = quantity(0, unit.factor);
    let n_27 = n_1 > n_26;
    let n_28 = quantity(0, unit.percentage_points);
    let n_29 = n_6 == n_28;
    let n_30 = if n_27 { n_28 } else { n_13 };
    let n_31 = pct(n_30, unit.factor);
    let n_32 = n_10 + n_31;
    let n_33 = scale(n_25, n_32);
    let n_34 = n_33 + n_7;
    let n_35 = round(n_34, quantity(1, unit.defence_rating), floor);
    effect "derive" when n_29 = derive(current, stat.local_defence_composition.channels.pre_override_armour, n_35);
}
