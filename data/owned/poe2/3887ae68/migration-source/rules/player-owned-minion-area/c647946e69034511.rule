program "player-owned-minion-area" context actor {
    read "incoming" as r_0: quantity(unit.percentage_points) = contributions(current, stat.growing_swarm.channels.area_player, increase, sum, quantity(0, unit.percentage_points));
    let n_0 = r_0;
    effect "final" = derive(current, stat.growing_swarm.channels.area_player, n_0);
}
