// Complete Sniper/Arsonist/Frost Mage/Reaver bodies and SkillStatMap2690-2696.
// Each exact Skill owns its intrinsic flag and 12000ms / 1000 base override.
// The shared body preserves distinct occurrences; no final-duration fallback.
program "intrinsic-revival" context skill {
    let reviving = true;
    let base_seconds = quantity(12, unit.seconds);
    effect "reviving" = contribute(current, stat.revival.enabled, flag, reviving);
    effect "base-duration" = contribute(current, stat.revival.base_override, override, base_seconds);
}
