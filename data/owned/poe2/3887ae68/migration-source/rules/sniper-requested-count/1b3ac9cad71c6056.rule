program "sniper-requested-count" context skill {
    read "count" as r_0: integer = parameter(parameter_slot.sniper_reservation.policy.parameter);
    let n_0 = r_0;
    let n_1 = quantity(1, unit.count);
    let n_2 = scale_integer(n_1, n_0);
    effect "requested-count" = derive(current, stat.skill_participation.count_stat, n_2);
}
