program "passive-view" context actor {
    let n_0 = any();
    let n_1 = any();
    let n_2 = quantity(10, unit.percentage_points);
    let n_3 = quantity(5, unit.percentage_points);
    let n_4 = quantity(5, unit.percentage_points);
    let n_5 = quantity(5, unit.percentage_points);
    let n_6 = false;
    let n_7 = not n_0;
    let n_8 = if n_1 { n_6 } else { n_7 };
    effect "default-effect-0" when n_8 = contribute(player, stat.player_evasion_final.contribution_stat, increase, n_2);
    effect "default-effect-1" when n_8 = contribute(player, stat.passive_defence_inputs.channels.armour_applies_to_fire.id, add, n_3);
    effect "default-effect-2" when n_8 = contribute(player, stat.passive_defence_inputs.channels.armour_applies_to_cold.id, add, n_4);
    effect "default-effect-3" when n_8 = contribute(player, stat.passive_defence_inputs.channels.armour_applies_to_lightning.id, add, n_5);
}
