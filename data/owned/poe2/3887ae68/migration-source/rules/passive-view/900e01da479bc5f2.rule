program "passive-view" context actor {
    let n_0 = any();
    let n_1 = any();
    let n_2 = quantity(4, unit.count);
    let n_3 = quantity(4, unit.count);
    let n_4 = false;
    let n_5 = not n_0;
    let n_6 = if n_1 { n_4 } else { n_5 };
    effect "default-effect-0" when n_6 = contribute(player, stat.attribute_empty_more.stages.strength_first.input, add, n_2);
    effect "default-effect-0-pass-two" when n_6 = contribute(player, stat.attribute_empty_more.stages.strength_second.input, add, n_2);
    effect "default-effect-1" when n_6 = contribute(player, stat.attribute_empty_more.stages.dexterity_first.input, add, n_3);
    effect "default-effect-1-pass-two" when n_6 = contribute(player, stat.attribute_empty_more.stages.dexterity_second.input, add, n_3);
}
