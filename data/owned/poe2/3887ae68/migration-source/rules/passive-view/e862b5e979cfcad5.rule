program "passive-view" context actor {
    let n_0 = any();
    let n_1 = any();
    let n_2 = quantity(6, unit.percentage_points);
    let n_3 = false;
    let n_4 = not n_0;
    let n_5 = if n_1 { n_3 } else { n_4 };
    effect "default-effect-0" when n_5 = contribute(player, stat.passive_defence_inputs.channels.energy_shield_recharge_delay.id, increase, n_2);
}
