program "passive-view" context actor {
    let n_0 = any();
    let n_1 = any();
    let n_2 = quantity(5, unit.percentage_points);
    let n_3 = false;
    let n_4 = not n_0;
    let n_5 = if n_1 { n_3 } else { n_4 };
    effect "default-effect-0" when n_5 = contribute(player, stat.attribute_empty_more.stages.strength_first.input, increase, n_2);
    effect "default-effect-0-pass-two" when n_5 = contribute(player, stat.attribute_empty_more.stages.strength_second.input, increase, n_2);
}
