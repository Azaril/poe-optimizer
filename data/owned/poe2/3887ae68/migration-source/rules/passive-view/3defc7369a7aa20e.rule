program "passive-view" context actor {
    read "match-0" as r_0: boolean = character_class_is(class.witch);
    let n_0 = any();
    let n_1 = quantity(8, unit.percentage_points);
    let n_2 = false;
    let n_3 = r_0;
    let n_4 = any(n_3);
    let n_5 = not n_0;
    let n_6 = if n_4 { n_2 } else { n_5 };
    let n_7 = quantity(8, unit.percentage_points);
    let n_8 = quantity(8, unit.percentage_points);
    effect "default-effect-0" when n_6 = contribute(player, stat.spell_damage_increase, increase, n_1);
    effect "view-0-effect-0" when n_3 = contribute(player, stat.spell_damage_increase, increase, n_7);
    effect "view-0-effect-1" when n_3 = contribute(player, stat.player_granted_minion_damage_increase, increase, n_8);
}
