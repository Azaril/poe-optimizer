program "passive-view" context actor {
    let n_0 = any();
    let n_1 = any();
    let n_2 = quantity(10, unit.count);
    let n_3 = false;
    let n_4 = not n_0;
    let n_5 = if n_1 { n_3 } else { n_4 };
    effect "default-effect-0" when n_5 = contribute(player, stat.attribute_empty_more.stages.intelligence_first.input, add, n_2);
    effect "default-effect-0-pass-two" when n_5 = contribute(player, stat.attribute_empty_more.stages.intelligence_second.input, add, n_2);
}
