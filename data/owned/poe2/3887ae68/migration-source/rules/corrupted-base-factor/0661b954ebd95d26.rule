program "corrupted-base-factor" context equipment_use {
    read "corrupted-base" as r_0: quantity(unit.factor) = parameter(parameter_slot.actor_attribute_inputs.all_attributes.modifier.item_attribute_inputs.corrupted_base_input);
    let n_0 = r_0;
    effect "corrupted-base-factor" = derive(modifier, stat.modifier_value_inputs.stats.corrupted_base_factor, n_0);
}
