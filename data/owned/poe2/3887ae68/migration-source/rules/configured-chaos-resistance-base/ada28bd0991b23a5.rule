program "configured-chaos-resistance-base" context actor {
    read "present" as r_0: boolean = external(current, external_input.incoming_damage_inputs.inputs.enemychaosresist.presence_input);
    read "raw" as r_1: quantity(unit.percentage_points) = external(current, external_input.incoming_damage_inputs.inputs.enemychaosresist.value_input);
    let n_0 = quantity(0, unit.percentage_points);
    let n_1 = r_0;
    let n_2 = r_1;
    let n_3 = if n_1 { n_2 } else { n_0 };
    effect "configured-base" = contribute(current, stat.configuration_resistance_inputs.inputs.enemychaosresist.contribution_stat, add, n_3);
}
