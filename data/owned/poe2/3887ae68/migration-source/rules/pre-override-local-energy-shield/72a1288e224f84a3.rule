program "pre-override-local-energy-shield" context equipment_use {
    read "all-increase" as r_0: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.defences_increase, increase, sum, quantity(0, unit.percentage_points));
    read "alternate-quality" as r_1: quantity(unit.factor) = contributions(current, stat.local_defence_composition.channels.alternate_quality, add, sum, quantity(0, unit.factor));
    read "armour_energy_shield-base" as r_2: quantity(unit.count) = contributions(current, stat.local_defence_composition.channels.armour_energy_shield, add, sum, quantity(0, unit.count));
    read "armour_energy_shield-increase" as r_3: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.armour_energy_shield, increase, sum, quantity(0, unit.percentage_points));
    read "crafted-quality" as r_4: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.crafted_quality, add, sum, quantity(0, unit.percentage_points));
    read "evasion_energy_shield-base" as r_5: quantity(unit.count) = contributions(current, stat.local_defence_composition.channels.evasion_energy_shield, add, sum, quantity(0, unit.count));
    read "evasion_energy_shield-increase" as r_6: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.evasion_energy_shield, increase, sum, quantity(0, unit.percentage_points));
    read "quality" as r_7: quantity(unit.percentage_points) = stat(current, stat.item_quality_inputs.quality_stat);
    read "raw" as r_8: quantity(unit.energy_shield_points) = stat(current, stat.defence_profiles.fields.energyshield.stat);
    read "single-base" as r_9: quantity(unit.energy_shield_points) = contributions(current, stat.local_defence_composition.channels.pre_override_energy_shield, add, sum, quantity(0, unit.energy_shield_points));
    read "single-increase" as r_10: quantity(unit.percentage_points) = contributions(current, stat.local_defence_composition.channels.pre_override_energy_shield, increase, sum, quantity(0, unit.percentage_points));
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = r_3;
    let n_4 = r_4;
    let n_5 = r_5;
    let n_6 = r_6;
    let n_7 = quantity(0.5, unit.energy_shield_points);
    let n_8 = quantity(1, unit.count);
    let n_9 = ratio(n_2, n_8, unit.factor);
    let n_10 = ratio(n_5, n_8, unit.factor);
    let n_11 = quantity(1, unit.factor);
    let n_12 = quantity(1, unit.energy_shield_points);
    let n_13 = scale(n_12, n_9);
    let n_14 = scale(n_12, n_10);
    let n_15 = r_7;
    let n_16 = r_8;
    let n_17 = r_9;
    let n_18 = n_17 + n_16;
    let n_19 = n_18 + n_14;
    let n_20 = n_19 + n_13;
    let n_21 = r_10;
    let n_22 = n_21 + n_3;
    let n_23 = n_22 + n_6;
    let n_24 = n_23 + n_0;
    let n_25 = pct(n_24, unit.factor);
    let n_26 = n_11 + n_25;
    let n_27 = scale(n_20, n_26);
    let n_28 = quantity(0, unit.factor);
    let n_29 = n_1 > n_28;
    let n_30 = quantity(0, unit.percentage_points);
    let n_31 = n_4 == n_30;
    let n_32 = if n_29 { n_30 } else { n_15 };
    let n_33 = pct(n_32, unit.factor);
    let n_34 = n_11 + n_33;
    let n_35 = scale(n_27, n_34);
    let n_36 = n_35 + n_7;
    let n_37 = round(n_36, quantity(1, unit.energy_shield_points), floor);
    effect "derive" when n_31 = derive(current, stat.local_defence_composition.channels.pre_override_energy_shield, n_37);
}
