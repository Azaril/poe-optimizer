program "catalyst-scalar" context equipment_use {
    read "catalyst-amount" as r_0: quantity(unit.percentage_points) = stat(current, stat.equipment_catalyst_enabled_amount);
    read "catalyst-kind" as r_1: option = stat(current, stat.equipment_catalyst_kind);
    read "property-armour" as r_2: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.armour);
    read "property-attack" as r_3: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.attack);
    read "property-attribute" as r_4: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.attribute);
    read "property-caster" as r_5: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.caster);
    read "property-chaos" as r_6: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.chaos);
    read "property-cold" as r_7: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.cold);
    read "property-defences" as r_8: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.defences);
    read "property-energyshield" as r_9: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.energyshield);
    read "property-evasion" as r_10: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.evasion);
    read "property-fire" as r_11: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.fire);
    read "property-life" as r_12: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.life);
    read "property-lightning" as r_13: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.lightning);
    read "property-mana" as r_14: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.mana);
    read "property-minion" as r_15: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.minion);
    read "property-physical" as r_16: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.physical);
    read "property-speed" as r_17: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.speed);
    read "unscalable" as r_18: boolean = parameter(parameter_slot.item_defence_inputs.evasion_energy_shield_base.canonical.property_inputs.unscalable);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = quantity(1, unit.factor);
    let n_3 = option(option.catalyst.attack);
    let n_4 = option(option.catalyst.attribute);
    let n_5 = option(option.catalyst.caster);
    let n_6 = option(option.catalyst.chaos);
    let n_7 = option(option.catalyst.cold);
    let n_8 = option(option.catalyst.defence);
    let n_9 = option(option.catalyst.fire);
    let n_10 = option(option.catalyst.life);
    let n_11 = option(option.catalyst.lightning);
    let n_12 = option(option.catalyst.mana);
    let n_13 = option(option.catalyst.minion);
    let n_14 = option(option.catalyst.physical);
    let n_15 = option(option.catalyst.speed);
    let n_16 = quantity(100, unit.percentage_points);
    let n_17 = n_16 + n_0;
    let n_18 = ratio(n_17, n_16, unit.factor);
    let n_19 = r_2;
    let n_20 = r_3;
    let n_21 = any(n_20);
    let n_22 = r_4;
    let n_23 = any(n_22);
    let n_24 = r_5;
    let n_25 = any(n_24);
    let n_26 = r_6;
    let n_27 = any(n_26);
    let n_28 = r_7;
    let n_29 = any(n_28);
    let n_30 = r_8;
    let n_31 = r_9;
    let n_32 = r_10;
    let n_33 = any(n_30, n_19, n_32, n_31);
    let n_34 = r_11;
    let n_35 = any(n_34);
    let n_36 = r_12;
    let n_37 = any(n_36);
    let n_38 = r_13;
    let n_39 = any(n_38);
    let n_40 = r_14;
    let n_41 = any(n_40);
    let n_42 = r_15;
    let n_43 = any(n_42);
    let n_44 = r_16;
    let n_45 = any(n_44);
    let n_46 = r_17;
    let n_47 = any(n_46);
    let n_48 = n_1 == n_3;
    let n_49 = all(n_48, n_21);
    let n_50 = n_1 == n_4;
    let n_51 = all(n_50, n_23);
    let n_52 = n_1 == n_5;
    let n_53 = all(n_52, n_25);
    let n_54 = n_1 == n_6;
    let n_55 = all(n_54, n_27);
    let n_56 = n_1 == n_7;
    let n_57 = all(n_56, n_29);
    let n_58 = n_1 == n_8;
    let n_59 = all(n_58, n_33);
    let n_60 = n_1 == n_9;
    let n_61 = all(n_60, n_35);
    let n_62 = n_1 == n_10;
    let n_63 = all(n_62, n_37);
    let n_64 = n_1 == n_11;
    let n_65 = all(n_64, n_39);
    let n_66 = n_1 == n_12;
    let n_67 = all(n_66, n_41);
    let n_68 = n_1 == n_13;
    let n_69 = all(n_68, n_43);
    let n_70 = n_1 == n_14;
    let n_71 = all(n_70, n_45);
    let n_72 = n_1 == n_15;
    let n_73 = all(n_72, n_47);
    let n_74 = any(n_63, n_67, n_59, n_71, n_61, n_57, n_65, n_55, n_49, n_53, n_73, n_51, n_69);
    let n_75 = if n_74 { n_18 } else { n_2 };
    let n_76 = r_18;
    let n_77 = if n_76 { n_2 } else { n_75 };
    effect "catalyst-scalar" = derive(modifier, stat.modifier_catalyst_scalar, n_77);
}
