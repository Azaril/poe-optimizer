program "ordinary-armour-adjusted-physical-averages" context action {
    read "armour-add" as r_0: quantity(unit.defence_rating) = contribution_query(enemy, "enemy-armour-add", "sources");
    read "armour-increase" as r_1: quantity(unit.percentage_points) = contribution_query(enemy, "enemy-armour-increase", "sources");
    read "armour-multiply" as r_2: quantity(unit.factor) = contribution_query(enemy, "enemy-armour-multiply", "sources");
    read "armour-override-present" as r_3: boolean = contribution_selection(enemy, "enemy-armour-override", "sources", present);
    read "armour-override-value" as r_4: quantity(unit.defence_rating) = contribution_selection(enemy, "enemy-armour-override", "sources", value);
    read "critical-multiplier" as r_5: quantity(unit.factor) = stat(current, stat.outgoing_critical_damage_multiplier);
    read "physical-max" as r_6: quantity(unit.damage) = stat(current, stat.selected_physical_hit_maximum);
    read "physical-min" as r_7: quantity(unit.damage) = stat(current, stat.selected_physical_hit_minimum);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = r_3;
    let n_4 = r_4;
    let n_5 = quantity(10, unit.factor);
    let n_6 = r_5;
    let n_7 = check_domain(n_6, quantity(0, unit.factor), quantity(, unit.factor));
    let n_8 = quantity(1, unit.damage);
    let n_9 = quantity(0.5, unit.factor);
    let n_10 = quantity(-1, unit.factor);
    let n_11 = quantity(1, unit.factor);
    let n_12 = quantity(0, unit.factor);
    let n_13 = pct(n_1, unit.factor);
    let n_14 = n_11 + n_13;
    let n_15 = scale(n_0, n_14);
    let n_16 = quantity(75, unit.percentage_points);
    let n_17 = quantity(-100, unit.percentage_points);
    let n_18 = quantity(100, unit.percentage_points);
    let n_19 = quantity(0, unit.percentage_points);
    let n_20 = r_6;
    let n_21 = check_domain(n_20, quantity(0, unit.damage), quantity(, unit.damage));
    let n_22 = scale(n_21, n_7);
    let n_23 = scale(n_22, n_9);
    let n_24 = scale(n_21, n_9);
    let n_25 = r_7;
    let n_26 = check_domain(n_25, quantity(0, unit.damage), quantity(, unit.damage));
    let n_27 = scale(n_26, n_7);
    let n_28 = scale(n_27, n_9);
    let n_29 = n_28 + n_23;
    let n_30 = ratio(n_29, n_8, unit.factor);
    let n_31 = scale(n_30, n_5);
    let n_32 = n_30 == n_12;
    let n_33 = scale(n_26, n_9);
    let n_34 = n_33 + n_24;
    let n_35 = ratio(n_34, n_8, unit.factor);
    let n_36 = scale(n_35, n_5);
    let n_37 = n_35 == n_12;
    let n_38 = quantity(1, unit.defence_rating);
    let n_39 = quantity(0, unit.defence_rating);
    let n_40 = scale(n_15, n_2);
    let n_41 = max(n_40, n_39);
    let n_42 = if n_3 { n_4 } else { n_41 };
    let n_43 = n_42 < n_39;
    let n_44 = scale(n_42, n_10);
    let n_45 = if n_43 { n_44 } else { n_42 };
    let n_46 = ratio(n_45, n_38, unit.factor);
    let n_47 = n_46 == n_12;
    let n_48 = all(n_47, n_32);
    let n_49 = n_46 + n_31;
    let n_50 = ratio(n_46, n_49, unit.factor);
    let n_51 = scale(n_18, n_50);
    let n_52 = scale(n_51, n_10);
    let n_53 = if n_43 { n_52 } else { n_51 };
    let n_54 = if n_48 { n_19 } else { n_53 };
    let n_55 = max(n_54, n_17);
    let n_56 = min(n_55, n_16);
    let n_57 = pct(n_56, unit.factor);
    let n_58 = n_11 - n_57;
    let n_59 = scale(n_29, n_58);
    let n_60 = all(n_47, n_37);
    let n_61 = n_46 + n_36;
    let n_62 = ratio(n_46, n_61, unit.factor);
    let n_63 = scale(n_18, n_62);
    let n_64 = scale(n_63, n_10);
    let n_65 = if n_43 { n_64 } else { n_63 };
    let n_66 = if n_60 { n_19 } else { n_65 };
    let n_67 = max(n_66, n_17);
    let n_68 = min(n_67, n_16);
    let n_69 = pct(n_68, unit.factor);
    let n_70 = n_11 - n_69;
    let n_71 = scale(n_34, n_70);
    effect "normal-average" = derive(current, stat.physical_hit_dps.inputs.normal.stat, n_71);
    effect "critical-average" = derive(current, stat.physical_hit_dps.inputs.critical.stat, n_59);
}
