program "contribute-player-flask-charge-generation" context equipment_use {
    read "direct-applicability" as r_0: boolean = stat(current, stat.ordinary_item_routing.channels.direct_applicability);
    read "effective" as r_1: quantity(unit.flask_charge_rate) = stat(modifier, stat.fine_belt_modifiers.flask.effective);
    let n_0 = r_0;
    let n_1 = r_1;
    effect "direct-flask-charge-generation" when n_0 = contribute(player, stat.player_flask_charge_generation, add, n_1);
}
