program "contribute-player-cold-resistance" context equipment_use {
    read "applicable" as r_0: boolean = stat(current, stat.cold_item_delivery.applicability);
    read "effective" as r_1: quantity(unit.percentage_points) = stat(modifier, stat.modifier_effective_percent);
    let n_0 = r_0;
    let n_1 = r_1;
    effect "direct-cold-resistance" when n_0 = contribute(player, stat.cold_resistance_base_contributions, add, n_1);
}
