program "pre-override-critical-chance" context equipment_use {
    read "flat" as r_0: quantity(unit.percentage_points) = contributions(current, stat.local_weapon_inputs.stats.pre_override_critical_chance, add, sum, quantity(0, unit.percentage_points));
    read "increase" as r_1: quantity(unit.percentage_points) = contributions(current, stat.local_weapon_inputs.stats.pre_override_critical_chance, increase, sum, quantity(0, unit.percentage_points));
    read "quality" as r_2: quantity(unit.percentage_points) = stat(current, stat.item_quality_inputs.quality_stat);
    read "quality-effect" as r_3: quantity(unit.percentage_points) = contributions(current, stat.local_weapon_inputs.stats.quality_critical_percent, add, sum, quantity(0, unit.percentage_points));
    read "raw" as r_4: quantity(unit.percentage_points) = stat(current, stat.weapon_profiles.fields.critchancebase.stat);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = quantity(1, unit.factor);
    let n_3 = r_2;
    let n_4 = quantity(4, unit.percentage_points);
    let n_5 = r_3;
    let n_6 = ratio(n_3, n_4, unit.factor);
    let n_7 = scale(n_5, n_6);
    let n_8 = round(n_7, quantity(1, unit.percentage_points), floor);
    let n_9 = r_4;
    let n_10 = quantity(0.5, unit.percentage_points);
    let n_11 = quantity(100, unit.factor);
    let n_12 = n_1 + n_8;
    let n_13 = pct(n_12, unit.factor);
    let n_14 = n_2 + n_13;
    let n_15 = n_9 + n_0;
    let n_16 = scale(n_15, n_14);
    let n_17 = scale(n_16, n_11);
    let n_18 = n_17 + n_10;
    let n_19 = round(n_18, quantity(1, unit.percentage_points), floor);
    let n_20 = divide_factor(n_19, n_11);
    effect "derive" = derive(current, stat.local_weapon_inputs.stats.pre_override_critical_chance, n_20);
}
