program "intrinsic-player-life" context actor {
    read "level" as r_0: integer = character_level();
    let n_0 = r_0;
    let n_1 = quantity(16, unit.life);
    let n_2 = quantity(12, unit.life);
    let n_3 = scale_integer(n_2, n_0);
    let n_4 = n_3 + n_1;
    effect "intrinsic-life" = contribute(current, stat.life, add, n_4);
}
