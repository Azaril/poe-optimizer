program "resolve-player-mana" context actor {
    read "extra" as r_0: quantity(unit.mana_points) = contribution_query(current, "additional-pre-scaling-mana-sources", "sources");
    read "inherent" as r_1: quantity(unit.mana_points) = contribution_query(current, "mana-base-contributions", "inherent");
    read "intrinsic" as r_2: quantity(unit.mana_points) = contribution_query(current, "mana-base-contributions", "intrinsic");
    read "more" as r_3: quantity(unit.factor) = contribution_query(current, "mana-more-contributions", "sources");
    read "override-present" as r_4: boolean = contribution_selection(current, "mana-override-contributions", "sources", present);
    read "override-value" as r_5: quantity(unit.mana_points) = contribution_selection(current, "mana-override-contributions", "sources", value);
    read "passive-increase" as r_6: quantity(unit.percentage_points) = contribution_query(current, "mana-increased-contributions", "passives");
    read "reward-increase" as r_7: quantity(unit.percentage_points) = contribution_query(current, "mana-increased-contributions", "rewards");
    read "to-armour" as r_8: quantity(unit.percentage_points) = contribution_query(current, "mana-conversion-to-armour-sources", "sources");
    read "to-energy-shield" as r_9: quantity(unit.percentage_points) = contribution_query(current, "mana-conversion-to-energy-shield-sources", "sources");
    read "to-evasion" as r_10: quantity(unit.percentage_points) = contribution_query(current, "mana-conversion-to-evasion-sources", "sources");
    read "total" as r_11: quantity(unit.mana_points) = contribution_query(current, "additional-post-scaling-mana-sources", "sources");
    let n_0 = r_0;
    let n_1 = quantity(100, unit.percentage_points);
    let n_2 = r_1;
    let n_3 = r_2;
    let n_4 = n_3 + n_2;
    let n_5 = r_3;
    let n_6 = quantity(1, unit.factor);
    let n_7 = quantity(1, unit.mana_points);
    let n_8 = r_4;
    let n_9 = r_5;
    let n_10 = r_6;
    let n_11 = r_7;
    let n_12 = n_11 + n_10;
    let n_13 = pct(n_12, unit.factor);
    let n_14 = n_6 + n_13;
    let n_15 = r_8;
    let n_16 = r_9;
    let n_17 = n_16 + n_15;
    let n_18 = r_10;
    let n_19 = n_17 + n_18;
    let n_20 = min(n_19, n_1);
    let n_21 = pct(n_20, unit.factor);
    let n_22 = n_6 - n_21;
    let n_23 = scale(n_4, n_22);
    let n_24 = n_23 + n_0;
    let n_25 = scale(n_24, n_14);
    let n_26 = scale(n_25, n_5);
    let n_27 = r_11;
    let n_28 = n_26 + n_27;
    let n_29 = check_domain(n_28, quantity(-, unit.mana_points), quantity(4503599627370496, unit.mana_points));
    let n_30 = round(n_29, quantity(1, unit.mana_points), nearest_ties_positive);
    let n_31 = max(n_30, n_7);
    let n_32 = if n_8 { n_9 } else { n_31 };
    effect "mana" = derive(current, stat.permanent_reward_effects.channels.mana, n_32);
}
