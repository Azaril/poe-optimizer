program "resolve-item-local-evasion" context equipment_use {
    read "alternate-quality" as r_0: quantity(unit.factor) = contribution_query(current, "item-evasion-alternate-quality", "sources");
    read "crafted-quality" as r_1: quantity(unit.percentage_points) = contribution_query(current, "item-evasion-crafted-quality", "sources");
    read "defences-increase" as r_2: quantity(unit.percentage_points) = contribution_query(current, "item-evasion-defences-increase", "sources");
    read "intrinsic" as r_3: quantity(unit.defence_rating) = stat(current, stat.defence_profiles.fields.evasion.stat);
    read "paired-armour-base" as r_4: quantity(unit.defence_rating) = contribution_query(current, "item-evasion-paired-armour-base", "sources");
    read "paired-armour-increase" as r_5: quantity(unit.percentage_points) = contribution_query(current, "item-evasion-paired-armour-increase", "sources");
    read "paired-shield-base" as r_6: quantity(unit.count) = contribution_query(current, "item-evasion-paired-shield-base", "sources");
    read "paired-shield-increase" as r_7: quantity(unit.percentage_points) = contribution_query(current, "item-evasion-paired-shield-increase", "sources");
    read "quality" as r_8: quantity(unit.percentage_points) = stat(current, stat.item_quality_inputs.quality_stat);
    read "single-base" as r_9: quantity(unit.defence_rating) = contribution_query(current, "item-evasion-single-base", "sources");
    read "single-increase" as r_10: quantity(unit.percentage_points) = contribution_query(current, "item-evasion-single-increase", "sources");
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = check_domain(n_1, quantity(0, unit.percentage_points), quantity(0, unit.percentage_points));
    let n_3 = r_2;
    let n_4 = quantity(0.5, unit.defence_rating);
    let n_5 = r_3;
    let n_6 = quantity(1, unit.count);
    let n_7 = quantity(1, unit.factor);
    let n_8 = quantity(1, unit.defence_rating);
    let n_9 = r_4;
    let n_10 = r_5;
    let n_11 = r_6;
    let n_12 = r_7;
    let n_13 = r_8;
    let n_14 = ratio(n_11, n_6, unit.factor);
    let n_15 = scale(n_8, n_14);
    let n_16 = r_9;
    let n_17 = n_16 + n_5;
    let n_18 = n_17 + n_9;
    let n_19 = n_18 + n_15;
    let n_20 = r_10;
    let n_21 = n_20 + n_10;
    let n_22 = n_21 + n_12;
    let n_23 = n_22 + n_3;
    let n_24 = pct(n_23, unit.factor);
    let n_25 = n_7 + n_24;
    let n_26 = scale(n_19, n_25);
    let n_27 = quantity(0, unit.factor);
    let n_28 = n_0 > n_27;
    let n_29 = quantity(0, unit.percentage_points);
    let n_30 = if n_28 { n_29 } else { n_13 };
    let n_31 = n_30 + n_2;
    let n_32 = pct(n_31, unit.factor);
    let n_33 = n_7 + n_32;
    let n_34 = scale(n_26, n_33);
    let n_35 = n_34 < n_4;
    let n_36 = check_domain(n_34, quantity(-4503599627370496, unit.defence_rating), quantity(0.4999999999999999, unit.defence_rating));
    let n_37 = check_domain(n_34, quantity(0.5, unit.defence_rating), quantity(4503599627370496, unit.defence_rating));
    let n_38 = if n_35 { n_36 } else { n_37 };
    let n_39 = round(n_38, quantity(1, unit.defence_rating), nearest_ties_positive);
    effect "local-evasion" = derive(current, stat.item_local_evasion, n_39);
}
