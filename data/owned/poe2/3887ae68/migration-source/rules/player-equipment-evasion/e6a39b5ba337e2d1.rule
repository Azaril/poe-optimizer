program "player-equipment-evasion" context actor {
    read "body-occupied" as r_0: boolean = player_equipment_slot(equipment_slot.body_armour, occupied());
    read "body-property" as r_1: quantity(unit.defence_rating) = player_equipment_slot(equipment_slot.body_armour, stat(stat.player_evasion_equipment.property));
    read "boots-occupied" as r_2: boolean = player_equipment_slot(equipment_slot.boots, occupied());
    read "boots-property" as r_3: quantity(unit.defence_rating) = player_equipment_slot(equipment_slot.boots, stat(stat.player_evasion_equipment.property));
    read "gloves-occupied" as r_4: boolean = player_equipment_slot(equipment_slot.gloves, occupied());
    read "gloves-property" as r_5: quantity(unit.defence_rating) = player_equipment_slot(equipment_slot.gloves, stat(stat.player_evasion_equipment.property));
    read "helmet-occupied" as r_6: boolean = player_equipment_slot(equipment_slot.helmet, occupied());
    read "helmet-property" as r_7: quantity(unit.defence_rating) = player_equipment_slot(equipment_slot.helmet, stat(stat.player_evasion_equipment.property));
    read "increase" as r_8: quantity(unit.percentage_points) = contribution_query(current, "player-evasion-increase", "sources");
    read "more" as r_9: quantity(unit.factor) = contribution_query(current, "player-evasion-more", "sources");
    read "offhand-occupied" as r_10: boolean = player_equipment_slot(equipment_slot.weapon_2, occupied());
    read "offhand-property" as r_11: quantity(unit.defence_rating) = player_equipment_slot(equipment_slot.weapon_2, stat(stat.player_evasion_equipment.property));
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = r_3;
    let n_4 = r_4;
    let n_5 = r_5;
    let n_6 = r_6;
    let n_7 = r_7;
    let n_8 = r_8;
    let n_9 = pct(n_8, unit.factor);
    let n_10 = r_9;
    let n_11 = r_10;
    let n_12 = r_11;
    let n_13 = quantity(1, unit.factor);
    let n_14 = n_13 + n_9;
    let n_15 = quantity(0, unit.defence_rating);
    let n_16 = if n_0 { n_1 } else { n_15 };
    let n_17 = scale(n_16, n_14);
    let n_18 = scale(n_17, n_10);
    let n_19 = if n_2 { n_3 } else { n_15 };
    let n_20 = scale(n_19, n_14);
    let n_21 = scale(n_20, n_10);
    let n_22 = if n_4 { n_5 } else { n_15 };
    let n_23 = scale(n_22, n_14);
    let n_24 = scale(n_23, n_10);
    let n_25 = if n_6 { n_7 } else { n_15 };
    let n_26 = scale(n_25, n_14);
    let n_27 = scale(n_26, n_10);
    let n_28 = n_15 + n_27;
    let n_29 = n_28 + n_24;
    let n_30 = n_29 + n_21;
    let n_31 = n_30 + n_18;
    let n_32 = if n_11 { n_12 } else { n_15 };
    let n_33 = scale(n_32, n_14);
    let n_34 = scale(n_33, n_10);
    let n_35 = n_31 + n_34;
    effect "scaled-equipment-evasion" = derive(current, stat.player_evasion_equipment.subtotal, n_35);
}
