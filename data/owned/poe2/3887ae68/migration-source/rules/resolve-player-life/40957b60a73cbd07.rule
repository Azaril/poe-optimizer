program "resolve-player-life" context actor {
    read "chaos-inoculation" as r_0: boolean = contribution_query(current, "life-chaos-inoculation-sources", "sources");
    read "equipment" as r_1: quantity(unit.life) = contribution_query(current, "life-base-contributions", "equipment");
    read "extra" as r_2: quantity(unit.life) = contribution_query(current, "additional-pre-scaling-life-sources", "sources");
    read "inherent" as r_3: quantity(unit.life) = contribution_query(current, "life-base-contributions", "inherent");
    read "intrinsic" as r_4: quantity(unit.life) = contribution_query(current, "life-base-contributions", "intrinsic");
    read "more" as r_5: quantity(unit.factor) = contribution_query(current, "life-more-contributions", "sources");
    read "override-present" as r_6: boolean = contribution_selection(current, "life-override-contributions", "sources", present);
    read "override-value" as r_7: quantity(unit.life) = contribution_selection(current, "life-override-contributions", "sources", value);
    read "received-increase" as r_8: quantity(unit.percentage_points) = contribution_query(current, "life-increased-contributions", "received");
    read "reward-base" as r_9: quantity(unit.life) = contribution_query(current, "life-base-contributions", "rewards");
    read "reward-increase" as r_10: quantity(unit.percentage_points) = contribution_query(current, "life-increased-contributions", "rewards");
    read "to-armour" as r_11: quantity(unit.percentage_points) = contribution_query(current, "life-conversion-to-armour-sources", "sources");
    read "to-energy-shield" as r_12: quantity(unit.percentage_points) = contribution_query(current, "life-conversion-to-energy-shield-sources", "sources");
    read "to-evasion" as r_13: quantity(unit.percentage_points) = contribution_query(current, "life-conversion-to-evasion-sources", "sources");
    read "total" as r_14: quantity(unit.life) = contribution_query(current, "additional-post-scaling-life-sources", "sources");
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = quantity(100, unit.percentage_points);
    let n_4 = r_3;
    let n_5 = r_4;
    let n_6 = n_5 + n_4;
    let n_7 = n_6 + n_1;
    let n_8 = r_5;
    let n_9 = quantity(1, unit.factor);
    let n_10 = quantity(1, unit.life);
    let n_11 = r_6;
    let n_12 = r_7;
    let n_13 = r_8;
    let n_14 = r_9;
    let n_15 = n_7 + n_14;
    let n_16 = r_10;
    let n_17 = n_16 + n_13;
    let n_18 = pct(n_17, unit.factor);
    let n_19 = n_9 + n_18;
    let n_20 = r_11;
    let n_21 = r_12;
    let n_22 = n_21 + n_20;
    let n_23 = r_13;
    let n_24 = n_22 + n_23;
    let n_25 = min(n_24, n_3);
    let n_26 = pct(n_25, unit.factor);
    let n_27 = n_9 - n_26;
    let n_28 = scale(n_15, n_27);
    let n_29 = n_28 + n_2;
    let n_30 = scale(n_29, n_19);
    let n_31 = scale(n_30, n_8);
    let n_32 = r_14;
    let n_33 = n_31 + n_32;
    let n_34 = check_domain(n_33, quantity(-, unit.life), quantity(4503599627370496, unit.life));
    let n_35 = round(n_34, quantity(1, unit.life), nearest_ties_positive);
    let n_36 = max(n_35, n_10);
    let n_37 = if n_11 { n_12 } else { n_36 };
    let n_38 = if n_0 { n_10 } else { n_37 };
    effect "life" = derive(current, stat.life, n_38);
}
