program "effective-amount" context equipment_use {
    read "component" as r_0: quantity(unit.percentage_points) = parameter(parameter_slot.movement_speed.modifier.amount);
    read "corruption-factor" as r_1: quantity(unit.factor) = stat(modifier, stat.modifier_value_inputs.stats.corrupted_base_factor);
    read "magnitude-factor" as r_2: quantity(unit.factor) = stat(modifier, stat.modifier_value_inputs.ordered_magnitude);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = quantity(1, unit.factor);
    let n_3 = quantity(0.5, unit.percentage_points);
    let n_4 = r_2;
    let n_5 = quantity(1, unit.factor);
    let n_6 = n_1 == n_5;
    let n_7 = n_4 == n_5;
    let n_8 = quantity(1, unit.factor);
    let n_9 = scale(n_0, n_8);
    let n_10 = n_9 - n_3;
    let n_11 = round(n_10, quantity(1, unit.percentage_points), ceiling);
    let n_12 = n_9 + n_3;
    let n_13 = round(n_12, quantity(1, unit.percentage_points), floor);
    let n_14 = quantity(0, unit.percentage_points);
    let n_15 = n_9 < n_14;
    let n_16 = if n_15 { n_11 } else { n_13 };
    let n_17 = scale(n_16, n_1);
    let n_18 = n_17 + n_3;
    let n_19 = round(n_18, quantity(1, unit.percentage_points), truncate);
    let n_20 = if n_6 { n_16 } else { n_19 };
    let n_21 = scale(n_20, n_4);
    let n_22 = round(n_21, quantity(1, unit.percentage_points), truncate);
    let n_23 = if n_7 { n_20 } else { n_22 };
    let n_24 = divide_factor(n_23, n_8);
    let n_25 = scale(n_24, n_2);
    let n_26 = n_25 - n_3;
    let n_27 = round(n_26, quantity(1, unit.percentage_points), ceiling);
    let n_28 = n_25 < n_14;
    let n_29 = n_25 + n_3;
    let n_30 = round(n_29, quantity(1, unit.percentage_points), floor);
    let n_31 = if n_28 { n_27 } else { n_30 };
    let n_32 = divide_factor(n_31, n_2);
    effect "effective-value" = derive(modifier, stat.modifier_effective_percent, n_32);
}
