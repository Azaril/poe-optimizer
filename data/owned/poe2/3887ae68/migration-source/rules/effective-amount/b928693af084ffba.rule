program "effective-amount" context equipment_use {
    read "component" as r_0: quantity(unit.percentage_points) = parameter(parameter_slot.item_defence_inputs.triple_defence_increase.canonical.canonical_inputs.amount);
    read "corruption-factor" as r_1: quantity(unit.factor) = stat(modifier, stat.modifier_value_inputs.stats.corrupted_base_factor);
    read "magnitude-factor" as r_2: quantity(unit.factor) = stat(modifier, stat.modifier_value_inputs.ordered_magnitude);
    read "negative" as r_3: boolean = parameter(parameter_slot.item_defence_inputs.triple_defence_increase.canonical.negative_input);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = quantity(1, unit.factor);
    let n_3 = quantity(0.5, unit.percentage_points);
    let n_4 = r_2;
    let n_5 = quantity(-1, unit.factor);
    let n_6 = r_3;
    let n_7 = quantity(1, unit.factor);
    let n_8 = n_1 == n_7;
    let n_9 = n_4 == n_7;
    let n_10 = quantity(1, unit.factor);
    let n_11 = scale(n_0, n_10);
    let n_12 = n_11 - n_3;
    let n_13 = round(n_12, quantity(1, unit.percentage_points), ceiling);
    let n_14 = n_11 + n_3;
    let n_15 = round(n_14, quantity(1, unit.percentage_points), floor);
    let n_16 = quantity(0, unit.percentage_points);
    let n_17 = n_11 < n_16;
    let n_18 = if n_17 { n_13 } else { n_15 };
    let n_19 = scale(n_18, n_1);
    let n_20 = n_19 + n_3;
    let n_21 = round(n_20, quantity(1, unit.percentage_points), truncate);
    let n_22 = if n_8 { n_18 } else { n_21 };
    let n_23 = scale(n_22, n_4);
    let n_24 = round(n_23, quantity(1, unit.percentage_points), truncate);
    let n_25 = if n_9 { n_22 } else { n_24 };
    let n_26 = divide_factor(n_25, n_10);
    let n_27 = scale(n_26, n_2);
    let n_28 = n_27 - n_3;
    let n_29 = round(n_28, quantity(1, unit.percentage_points), ceiling);
    let n_30 = n_27 < n_16;
    let n_31 = n_27 + n_3;
    let n_32 = round(n_31, quantity(1, unit.percentage_points), floor);
    let n_33 = if n_30 { n_29 } else { n_32 };
    let n_34 = divide_factor(n_33, n_2);
    let n_35 = scale(n_34, n_5);
    let n_36 = if n_6 { n_35 } else { n_34 };
    effect "effective-value" = derive(modifier, stat.modifier_effective_percent, n_36);
}
