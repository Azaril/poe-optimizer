program "effective-amount" context equipment_use {
    read "base-rounding-present" as r_0: boolean = parameter(parameter_slot.item_defence_inputs.defences_increase.canonical.base_rounding_present_input);
    read "component" as r_1: quantity(unit.percentage_points) = parameter(parameter_slot.item_defence_inputs.defences_increase.canonical.canonical_inputs.amount);
    read "corruption-factor" as r_2: quantity(unit.factor) = stat(modifier, stat.modifier_value_inputs.stats.corrupted_base_factor);
    read "decimal-quantization" as r_3: boolean = parameter(parameter_slot.item_defence_inputs.defences_increase.canonical.decimal_quantization_input);
    read "magnitude-factor" as r_4: quantity(unit.factor) = stat(modifier, stat.modifier_value_inputs.ordered_magnitude);
    read "negative" as r_5: boolean = parameter(parameter_slot.item_defence_inputs.defences_increase.canonical.negative_input);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = scale(n_1, n_2);
    let n_4 = quantity(10, unit.factor);
    let n_5 = scale(n_3, n_4);
    let n_6 = r_3;
    let n_7 = false;
    let n_8 = quantity(0.5, unit.percentage_points);
    let n_9 = n_5 + n_8;
    let n_10 = round(n_9, quantity(1, unit.percentage_points), floor);
    let n_11 = divide_factor(n_10, n_4);
    let n_12 = if n_0 { n_11 } else { n_1 };
    let n_13 = n_3 + n_8;
    let n_14 = round(n_13, quantity(1, unit.percentage_points), floor);
    let n_15 = if n_0 { n_14 } else { n_1 };
    let n_16 = quantity(0.001, unit.percentage_points);
    let n_17 = r_4;
    let n_18 = scale(n_12, n_17);
    let n_19 = scale(n_18, n_4);
    let n_20 = round(n_19, quantity(1, unit.percentage_points), floor);
    let n_21 = divide_factor(n_20, n_4);
    let n_22 = scale(n_15, n_17);
    let n_23 = n_22 + n_16;
    let n_24 = round(n_23, quantity(1, unit.percentage_points), floor);
    let n_25 = if n_6 { n_21 } else { n_24 };
    let n_26 = quantity(-1, unit.factor);
    let n_27 = r_5;
    let n_28 = quantity(1, unit.factor);
    let n_29 = n_2 == n_28;
    let n_30 = n_17 == n_28;
    let n_31 = true;
    let n_32 = if n_0 { n_29 } else { n_31 };
    let n_33 = if n_30 { n_32 } else { n_7 };
    let n_34 = if n_33 { n_1 } else { n_25 };
    let n_35 = scale(n_34, n_26);
    let n_36 = if n_27 { n_35 } else { n_34 };
    let n_37 = quantity(0, unit.percentage_points);
    effect "effective-value" = derive(modifier, stat.modifier_effective_percent, n_36);
}
