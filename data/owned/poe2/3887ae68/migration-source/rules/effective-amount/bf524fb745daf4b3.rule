program "effective-amount" context equipment_use {
    read "base-rounding-present" as r_0: boolean = parameter(parameter_slot.item_defence_inputs.armour_energy_shield_base.canonical.base_rounding_present_input);
    read "component" as r_1: quantity(unit.count) = parameter(parameter_slot.item_defence_inputs.armour_energy_shield_base.canonical.canonical_inputs.amount);
    read "corruption-factor" as r_2: quantity(unit.factor) = stat(modifier, stat.modifier_value_inputs.stats.corrupted_base_factor);
    read "decimal-quantization" as r_3: boolean = parameter(parameter_slot.item_defence_inputs.armour_energy_shield_base.canonical.decimal_quantization_input);
    read "magnitude-factor" as r_4: quantity(unit.factor) = stat(modifier, stat.modifier_value_inputs.ordered_magnitude);
    let n_0 = r_0;
    let n_1 = r_1;
    let n_2 = r_2;
    let n_3 = quantity(10, unit.factor);
    let n_4 = r_3;
    let n_5 = false;
    let n_6 = quantity(0.5, unit.count);
    let n_7 = quantity(0.001, unit.count);
    let n_8 = r_4;
    let n_9 = quantity(-1, unit.factor);
    let n_10 = scale(n_1, n_9);
    let n_11 = quantity(1, unit.factor);
    let n_12 = n_2 == n_11;
    let n_13 = n_8 == n_11;
    let n_14 = true;
    let n_15 = if n_0 { n_12 } else { n_14 };
    let n_16 = if n_13 { n_15 } else { n_5 };
    let n_17 = quantity(0, unit.count);
    let n_18 = n_1 < n_17;
    let n_19 = if n_18 { n_10 } else { n_1 };
    let n_20 = scale(n_19, n_2);
    let n_21 = scale(n_20, n_3);
    let n_22 = n_21 + n_6;
    let n_23 = round(n_22, quantity(1, unit.count), floor);
    let n_24 = divide_factor(n_23, n_3);
    let n_25 = if n_0 { n_24 } else { n_19 };
    let n_26 = scale(n_25, n_8);
    let n_27 = scale(n_26, n_3);
    let n_28 = round(n_27, quantity(1, unit.count), floor);
    let n_29 = divide_factor(n_28, n_3);
    let n_30 = n_20 + n_6;
    let n_31 = round(n_30, quantity(1, unit.count), floor);
    let n_32 = if n_0 { n_31 } else { n_19 };
    let n_33 = scale(n_32, n_8);
    let n_34 = n_33 + n_7;
    let n_35 = round(n_34, quantity(1, unit.count), floor);
    let n_36 = if n_4 { n_29 } else { n_35 };
    let n_37 = if n_16 { n_19 } else { n_36 };
    let n_38 = scale(n_37, n_9);
    let n_39 = if n_18 { n_38 } else { n_37 };
    effect "effective-value" = derive(modifier, stat.modifier_effective_count, n_39);
}
