// Exact contribution authority and coverage; compiled through the shared rule validator.
queries game="poe2" version="owned-mechanics-v1" coverage="complete" {
    query "spirit-base-contributions" stat="stat.player_spirit_pool.final" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="partial" {
            empty type="quantity" value="0" unit="unit.spirit_points"
            member "program_effect" owner="reward.questact_1freythornking_in_the_mists" program="flat-resource-contribution" effect="grant" {
                origin kind="reward"
                order source="0" program="0" effect="0"
            }
            member "program_effect" owner="reward.questact_3azak_bogignagduk" program="flat-resource-contribution" effect="grant" {
                origin kind="reward"
                order source="1" program="0" effect="0"
            }
            member "program_effect" owner="reward.questinterlude_3kriar_villagelythara" program="flat-resource-contribution" effect="grant" {
                origin kind="reward"
                order source="2" program="0" effect="0"
            }
            member "program_effect" owner="modifier.fixed_spirit.modifier" program="contribute-player-ranged-spirit" effect="direct-ranged-spirit" {
                origin kind="item_modifier" {
                    slot "equipment_slot.weapon_1"
                    slot "equipment_slot.weapon_2"
                    slot "equipment_slot.helmet"
                    slot "equipment_slot.body_armour"
                    slot "equipment_slot.gloves"
                    slot "equipment_slot.boots"
                    slot "equipment_slot.amulet"
                    slot "equipment_slot.ring_1"
                    slot "equipment_slot.ring_2"
                    slot "equipment_slot.ring_3"
                    slot "equipment_slot.belt"
                    slot "equipment_slot.flask_1"
                    slot "equipment_slot.flask_2"
                    slot "equipment_slot.charm_1"
                    slot "equipment_slot.charm_2"
                    slot "equipment_slot.charm_3"
                    slot "equipment_slot.arm_1"
                    slot "equipment_slot.arm_2"
                    slot "equipment_slot.leg_1"
                    slot "equipment_slot.leg_2"
                }
                order source="3" program="0" effect="0" {
                    slot-rank "equipment_slot.weapon_1" rank="0"
                    slot-rank "equipment_slot.weapon_2" rank="1"
                    slot-rank "equipment_slot.helmet" rank="2"
                    slot-rank "equipment_slot.body_armour" rank="3"
                    slot-rank "equipment_slot.gloves" rank="4"
                    slot-rank "equipment_slot.boots" rank="5"
                    slot-rank "equipment_slot.amulet" rank="6"
                    slot-rank "equipment_slot.ring_1" rank="7"
                    slot-rank "equipment_slot.ring_2" rank="8"
                    slot-rank "equipment_slot.ring_3" rank="9"
                    slot-rank "equipment_slot.belt" rank="10"
                    slot-rank "equipment_slot.flask_1" rank="11"
                    slot-rank "equipment_slot.flask_2" rank="12"
                    slot-rank "equipment_slot.charm_1" rank="13"
                    slot-rank "equipment_slot.charm_2" rank="14"
                    slot-rank "equipment_slot.charm_3" rank="15"
                    slot-rank "equipment_slot.arm_1" rank="16"
                    slot-rank "equipment_slot.arm_2" rank="17"
                    slot-rank "equipment_slot.leg_1" rank="18"
                    slot-rank "equipment_slot.leg_2" rank="19"
                }
            }
            member "program_effect" owner="modifier.fixed_spirit.modifier" program="amulet-copy-ranged-spirit" effect="copied-ranged-spirit" {
                origin kind="item_modifier" {
                    slot "equipment_slot.weapon_1"
                    slot "equipment_slot.weapon_2"
                    slot "equipment_slot.helmet"
                    slot "equipment_slot.body_armour"
                    slot "equipment_slot.gloves"
                    slot "equipment_slot.boots"
                    slot "equipment_slot.amulet"
                    slot "equipment_slot.ring_1"
                    slot "equipment_slot.ring_2"
                    slot "equipment_slot.ring_3"
                    slot "equipment_slot.belt"
                    slot "equipment_slot.flask_1"
                    slot "equipment_slot.flask_2"
                    slot "equipment_slot.charm_1"
                    slot "equipment_slot.charm_2"
                    slot "equipment_slot.charm_3"
                    slot "equipment_slot.arm_1"
                    slot "equipment_slot.arm_2"
                    slot "equipment_slot.leg_1"
                    slot "equipment_slot.leg_2"
                }
                order source="3" program="1" effect="0" {
                    slot-rank "equipment_slot.weapon_1" rank="0"
                    slot-rank "equipment_slot.weapon_2" rank="1"
                    slot-rank "equipment_slot.helmet" rank="2"
                    slot-rank "equipment_slot.body_armour" rank="3"
                    slot-rank "equipment_slot.gloves" rank="4"
                    slot-rank "equipment_slot.boots" rank="5"
                    slot-rank "equipment_slot.amulet" rank="6"
                    slot-rank "equipment_slot.ring_1" rank="7"
                    slot-rank "equipment_slot.ring_2" rank="8"
                    slot-rank "equipment_slot.ring_3" rank="9"
                    slot-rank "equipment_slot.belt" rank="10"
                    slot-rank "equipment_slot.flask_1" rank="11"
                    slot-rank "equipment_slot.flask_2" rank="12"
                    slot-rank "equipment_slot.charm_1" rank="13"
                    slot-rank "equipment_slot.charm_2" rank="14"
                    slot-rank "equipment_slot.charm_3" rank="15"
                    slot-rank "equipment_slot.arm_1" rank="16"
                    slot-rank "equipment_slot.arm_2" rank="17"
                    slot-rank "equipment_slot.leg_1" rank="18"
                    slot-rank "equipment_slot.leg_2" rank="19"
                }
            }
            gap subject="stat.player_spirit_pool.final" facet="game_rules" code="unreviewed-spirit-contributor-membership-and-order"
        }
    }
    query "spirit-increased-contributions" stat="stat.player_spirit_pool.final" contribution="increase" {
        group "sources" reduction="sum" ordering="ordered" coverage="partial" {
            empty type="quantity" value="0" unit="unit.percentage_points"
            gap subject="stat.player_spirit_pool.final" facet="game_rules" code="unreviewed-spirit-contributor-membership-and-order"
        }
    }
    query "spirit-more-contributions" stat="stat.player_spirit_pool.final" contribution="multiply" {
        group "sources" reduction="product" ordering="ordered" coverage="partial" {
            empty type="quantity" value="1" unit="unit.factor"
            gap subject="stat.player_spirit_pool.final" facet="game_rules" code="unreviewed-spirit-contributor-membership-and-order"
        }
    }
    query "spirit-conversion-to-energy-shield-sources" stat="stat.spirit_conversion_to_energy_shield_sources" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="partial" {
            empty type="quantity" value="0" unit="unit.percentage_points"
            gap subject="stat.spirit_conversion_to_energy_shield_sources" facet="game_rules" code="unreviewed-spirit-adjustment-suppliers-and-order"
        }
    }
    query "spirit-conversion-to-armour-sources" stat="stat.spirit_conversion_to_armour_sources" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="partial" {
            empty type="quantity" value="0" unit="unit.percentage_points"
            gap subject="stat.spirit_conversion_to_armour_sources" facet="game_rules" code="unreviewed-spirit-adjustment-suppliers-and-order"
        }
    }
    query "spirit-conversion-to-evasion-sources" stat="stat.spirit_conversion_to_evasion_sources" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="partial" {
            empty type="quantity" value="0" unit="unit.percentage_points"
            gap subject="stat.spirit_conversion_to_evasion_sources" facet="game_rules" code="unreviewed-spirit-adjustment-suppliers-and-order"
        }
    }
    query "additional-pre-scaling-spirit-sources" stat="stat.additional_pre_scaling_spirit_sources" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="partial" {
            empty type="quantity" value="0" unit="unit.spirit_points"
            gap subject="stat.additional_pre_scaling_spirit_sources" facet="game_rules" code="unreviewed-spirit-adjustment-suppliers-and-order"
        }
    }
    query "additional-post-scaling-spirit-sources" stat="stat.additional_post_scaling_spirit_sources" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="partial" {
            empty type="quantity" value="0" unit="unit.spirit_points"
            gap subject="stat.additional_post_scaling_spirit_sources" facet="game_rules" code="unreviewed-spirit-adjustment-suppliers-and-order"
        }
    }
    query "spirit-override-contributions" stat="stat.player_spirit_pool.final" contribution="override" {
        group "sources" reduction="require_agreement" ordering="unordered" coverage="partial" {
            gap subject="stat.player_spirit_pool.final" facet="game_rules" code="unreviewed-spirit-override-suppliers"
        }
    }
    query "selected-physical-self-flat-minimum" stat="stat.selected_physical_self_flat_minimum" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="complete" {
            empty type="quantity" value="0" unit="unit.damage"
        }
    }
    query "selected-physical-self-flat-maximum" stat="stat.selected_physical_self_flat_maximum" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="complete" {
            empty type="quantity" value="0" unit="unit.damage"
        }
    }
    query "selected-actor-intimidated" stat="stat.selected_actor_intimidated" contribution="flag" {
        group "sources" reduction="any" ordering="unordered" coverage="complete" {
            empty type="boolean" value="false"
        }
    }
    query "selected-actor-debilitated" stat="stat.selected_actor_debilitated" contribution="flag" {
        group "sources" reduction="any" ordering="unordered" coverage="complete" {
            empty type="boolean" value="false"
        }
    }
    query "pain-offering-speed-contributions" stat="stat.pain_offering_speed_contributions" contribution="add" {
        group "pain-offering-speed" reduction="sum" ordering="ordered" coverage="complete" {
            empty type="quantity" value="0" unit="unit.percentage_points"
            member "application_group" family="pain-offering-buff" modifier="attack-cast-speed-increase" {
                declaration application="pain-offering-minion-damage" effect="speed-increase"
                order source="0" program="0" effect="0"
            }
        }
    }
    query "player-evasion-base" stat="stat.player_evasion_final.contribution_stat" contribution="add" {
        group "sources" reduction="sum" ordering="ordered" coverage="complete" {
            empty type="quantity" value="0" unit="unit.defence_rating"
            member "program_effect" owner="actor.player" program="intrinsic-player-evasion" effect="inherent-evasion" {
                origin kind="existing_actor" application="shared-player-initialization"
                order source="0" program="0" effect="0"
            }
        }
    }
    query "player-evasion-increase" stat="stat.player_evasion_final.contribution_stat" contribution="increase" {
